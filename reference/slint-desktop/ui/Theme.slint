// Central design tokens: mode toggle, spacing scale, corner radii, motion.
// Colors and Typography live in their own files and read `Theme.dark`.

import { UIState } from "Types.slint";
import { Palette } from "std-widgets.slint";

export global Theme {
    // The chosen palette id (AW's theme catalog; see Colors.slint), straight
    // from UIState -- which Rust owns and persists as the `theme` settings row.
    //
    // "system" is the one id that is not a palette: it is resolved here against
    // the platform's colour scheme, which is the only place this shell can ask
    // for it. Everything downstream -- including the picker -- reads a real id.
    out property <string> theme: UIState.theme == "system"
        ? (Palette.color-scheme == ColorScheme.dark ? "midnight" : "light")
        : (UIState.theme == "" ? "midnight" : UIState.theme);

    // The one mode flag the rest of the shell branches on. Derived, never
    // stored: `light` is the only light palette in the catalog, so asking the
    // resolved id is the whole question, and a second source of truth could
    // only ever disagree with the first.
    out property <bool> dark: Theme.theme != "light";

    // ---- spacing scale (the only allowed step ladder) ----
    out property <length> spacing-xxs: 2px;
    out property <length> spacing-xs: 4px;
    out property <length> spacing-sm: 8px;
    out property <length> spacing-md: 12px;
    out property <length> spacing-lg: 16px;
    out property <length> spacing-xl: 24px;
    out property <length> spacing-xxl: 32px;
    out property <length> spacing-hero: 64px;

    // ---- corner radius ----
    out property <length> radius-xs: 3px;
    out property <length> radius-sm: 5px;
    out property <length> radius-md: 8px;
    out property <length> radius-lg: 12px;
    out property <length> radius-xl: 16px;

    // ---- structural metrics ----
    out property <length> titlebar-height: 40px;
    // The sidebar's width, owned by the user (the right-edge drag handle;
    // Rust persists it) rather than by the design tokens. The default here is
    // also the fallback state.rs reads when the settings row is absent.
    out property <length> sidebar-width: UIState.sidebar-width * 1px;
    out property <length> editor-max-width: 760px;
    out property <length> editor-side-padding: 96px;

    // ---- motion: feedback, never idle loops ----
    out property <duration> duration-instant: 80ms;
    out property <duration> duration-fast: 140ms;
    out property <duration> duration-normal: 220ms;
    out property <duration> duration-slow: 320ms;
}
