component IcRestore {
    in property <brush> color: Colors.text-secondary;
    in property <length> size: 16px;
    width: size; height: size;
    Path {
        width: parent.width; height: parent.height;
        viewbox-x: 0; viewbox-y: 0; viewbox-width: 24; viewbox-height: 24;
        stroke: color; stroke-width: 1.5px;
        fill: transparent;
        // two overlapping squares, front one smaller and tucked into the
        // bottom-left — the shell's own shape, not the platform glyph, so it
        // sits with IcMaximize at the same weight
        MoveTo { x: 9; y: 6; } LineTo { x: 18; y: 6; }
        LineTo { x: 18; y: 13; } LineTo { x: 9; y: 13; } Close {}
        MoveTo { x: 6; y: 11; } LineTo { x: 15; y: 11; }
        LineTo { x: 15; y: 18; } LineTo { x: 6; y: 18; } Close {}
    }
}

