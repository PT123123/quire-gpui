        viewbox-x: 0; viewbox-y: 0; viewbox-width: 24; viewbox-height: 24;
        stroke: color; stroke-width: 1.8px; stroke-line-cap: round;
        fill: transparent;
        MoveTo { x: 12; y: 8.5; }
        ArcTo { radius-x: 3.5; radius-y: 3.5; x: 12; y: 15.5; }
        ArcTo { radius-x: 3.5; radius-y: 3.5; x: 12; y: 8.5; }
        MoveTo { x: 12; y: 2.5; } LineTo { x: 12; y: 4.5; }
        MoveTo { x: 12; y: 19.5; } LineTo { x: 12; y: 21.5; }
        MoveTo { x: 2.5; y: 12; } LineTo { x: 4.5; y: 12; }
        MoveTo { x: 19.5; y: 12; } LineTo { x: 21.5; y: 12; }
        MoveTo { x: 5.3; y: 5.3; } LineTo { x: 6.7; y: 6.7; }
        MoveTo { x: 17.3; y: 17.3; } LineTo { x: 18.7; y: 18.7; }
        MoveTo { x: 18.7; y: 5.3; } LineTo { x: 17.3; y: 6.7; }
        MoveTo { x: 6.7; y: 17.3; } LineTo { x: 5.3; y: 18.7; }
    }
}

component IcMoon {
