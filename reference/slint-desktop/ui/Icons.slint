        stroke: color; stroke-width: 1.8px;
        stroke-line-cap: round; stroke-line-join: round;
        fill: transparent;
        MoveTo { x: 9.5; y: 5; }
        LineTo { x: 16.5; y: 12; }
        LineTo { x: 9.5; y: 19; }
    }
}

