component IcPalette {
    in property <brush> color: Colors.text-secondary;
    in property <length> size: 16px;
    width: size; height: size;
    Path {
        width: parent.width; height: parent.height;
        viewbox-x: 0; viewbox-y: 0; viewbox-width: 24; viewbox-height: 24;
        stroke: color; stroke-width: 1.8px;
        stroke-line-cap: round; stroke-line-join: round;
        fill: transparent;
        MoveTo { x: 12; y: 3.5; }
        CubicTo { control-1-x: 9.5; control-1-y: 8; control-2-x: 5.5; control-2-y: 11; x: 5.5; y: 15; }
        ArcTo { radius-x: 6.5; radius-y: 6.5; x: 18.5; y: 15; }
        CubicTo { control-1-x: 18.5; control-1-y: 11; control-2-x: 14.5; control-2-y: 8; x: 12; y: 3.5; }
    }
}

/// lucide's `image`: frame + sun + ridge. Slint's shapes are Rectangle and
/// Path, so the sun is a rounded square and only the ridge is path geometry.
component IcImage {
    in property <brush> color: Colors.text-secondary;
    in property <length> size: 16px;
    width: size; height: size;
    Rectangle {
        x: root.size * 3 / 24;
        y: root.size * 3 / 24;
        width: root.size * 18 / 24;
        height: root.size * 18 / 24;
        border-radius: root.size * 2 / 24;
        border-width: 1.5px;
        border-color: color;
    }
    Rectangle {
        x: root.size * 7.4 / 24;
        y: root.size * 7.4 / 24;
        width: root.size * 3.2 / 24;
        height: root.size * 3.2 / 24;
        border-radius: root.size * 1.6 / 24;
        background: color;
    }
    Path {
        width: parent.width; height: parent.height;
        viewbox-x: 0; viewbox-y: 0; viewbox-width: 24; viewbox-height: 24;
        stroke: color; stroke-width: 1.8px;
        stroke-line-cap: round; stroke-line-join: round;
        fill: transparent;
        MoveTo { x: 20; y: 15; } LineTo { x: 15; y: 10; } LineTo { x: 5; y: 21; }
    }
}

// The page menu's "Set icon" row (SPEC §三十八): a face, because the thing it
// opens is the emoji grid. The picture-frame glyph stays free for the cover.
component IcSmile {
    in property <brush> color: Colors.text-secondary;
    in property <length> size: 16px;
    width: size; height: size;
    Path {
        width: parent.width; height: parent.height;
        viewbox-x: 0; viewbox-y: 0; viewbox-width: 24; viewbox-height: 24;
        stroke: color; stroke-width: 1.8px;
        stroke-line-cap: round; stroke-line-join: round;
        fill: transparent;
        MoveTo { x: 12; y: 4; }
        ArcTo { radius-x: 8; radius-y: 8; x: 12; y: 20; }
        ArcTo { radius-x: 8; radius-y: 8; x: 12; y: 4; }
        // the smile is a curve, not an arc: an ArcTo here has no sweep flag to
        // ask for, and would happily bulge upwards into a frown
        MoveTo { x: 8.5; y: 14; }
        CubicTo { control-1-x: 9.8; control-1-y: 16.8; control-2-x: 14.2; control-2-y: 16.8; x: 15.5; y: 14; }
    }
    Rectangle {
        x: root.size * 8.2 / 24;
        y: root.size * 9 / 24;
        width: root.size * 1.8 / 24;
        height: root.size * 1.8 / 24;
        border-radius: root.size / 24;
        background: color;
    }
    Rectangle {
        x: root.size * 14 / 24;
        y: root.size * 9 / 24;
        width: root.size * 1.8 / 24;
        height: root.size * 1.8 / 24;
        border-radius: root.size / 24;
        background: color;
    }
}

// The page's read-only switch (SPEC §三十八 "lock"): a padlock, shackle over
// body, so the chip that names the state is not the only thing saying it.
component IcLock {
    in property <brush> color: Colors.text-secondary;
    in property <length> size: 16px;
    width: size; height: size;
    Path {
        width: parent.width; height: parent.height;
        viewbox-x: 0; viewbox-y: 0; viewbox-width: 24; viewbox-height: 24;
        stroke: color; stroke-width: 1.8px;
        stroke-line-cap: round; stroke-line-join: round;
        fill: transparent;
        // shackle: up the left leg, over the top, down the right leg
        MoveTo { x: 8.5; y: 11; } LineTo { x: 8.5; y: 8; }
        ArcTo { radius-x: 3.5; radius-y: 3.5; x: 15.5; y: 8; }
        LineTo { x: 15.5; y: 11; }
        // body
        MoveTo { x: 5.5; y: 11; } LineTo { x: 18.5; y: 11; }
        LineTo { x: 18.5; y: 20.5; } LineTo { x: 5.5; y: 20.5; } Close {}
        // keyhole, one short stroke: at 16px a dot is a printing artefact
        MoveTo { x: 12; y: 14.5; } LineTo { x: 12; y: 17.5; }
    }
}

// The capture layer's ➤ (ADR-0115). Drawn and not typed: `➤` is U+27A4, in the
// same Dingbats block as the `✕` this set already had to replace — a `Text` of a
// glyph no face in this font chain carries is an invisible control whose
// `TouchArea` still answers. The shape is the reference shell's own send icon: a
// paper plane, its nose at the right and the two tail edges meeting at the notch.
component IcSend {
    in property <brush> color: Colors.text-secondary;
    in property <length> size: 16px;
    width: size; height: size;
    Path {
        width: parent.width; height: parent.height;
        viewbox-x: 0; viewbox-y: 0; viewbox-width: 24; viewbox-height: 24;
        stroke: color; stroke-width: 1.8px;
        stroke-line-cap: round; stroke-line-join: round;
        fill: transparent;
        MoveTo { x: 2.5; y: 20.5; }
        LineTo { x: 21; y: 12; }
        LineTo { x: 2.5; y: 3.5; }
        LineTo { x: 2.5; y: 10; }
        LineTo { x: 13.5; y: 12; }
        LineTo { x: 2.5; y: 14; }
        Close {}
    }
}

// 刷新 (⟳): the 笔记 toolbar's round with every device, and the sync page's own
// re-read of the peers table. Drawn and not typed for the same reason as `IcSend`
// above: `⟳` is U+27F3, a Miscellaneous Symbols glyph this font chain does not
// carry, and a `Text` of it is an invisible control whose `TouchArea` still
// answers. The reference's own button is this glyph in a 30 px box; here it is
// a `Path` so it renders whatever fonts the machine has.
//
// The head is the open end of the arc: a full circle with a gap is what tells
// the reader this arrow comes round again, where a ring alone reads as a ring.
component IcRefresh {
    in property <brush> color: Colors.text-secondary;
    in property <length> size: 16px;
    width: size; height: size;
    Path {
        width: parent.width; height: parent.height;
        viewbox-x: 0; viewbox-y: 0; viewbox-width: 24; viewbox-height: 24;
        stroke: color; stroke-width: 1.8px;
        stroke-line-cap: round; stroke-line-join: round;
        fill: transparent;
        // The ring: centre (12, 12), radius 7.4, open at the top over the 90°
        // between 225° and 315° — a ring with a notch rather than a ring with a
        // slice missing, which is what makes it read as "round again" and not
        // as two unrelated strokes.
        //
        // `large-arc` and `sweep` are load-bearing here, not decoration: two
        // points can be joined by two different arcs of the same radius, and
        // with both flags left at their `false` default Slint draws the
        // **minor** one — a 90° sliver across the top where there is no ink to
        // spare, since the chevron below sits there. The ring the comment above
        // promises is the 270° major arc, which is `large-arc: true` with the
        // positive-angle (clockwise) direction, `sweep: true`.
        MoveTo { x: 17.23; y: 6.77; }
        ArcTo {
            radius-x: 7.4; radius-y: 7.4; x: 6.77; y: 6.77;
            large-arc: true; sweep: true;
        }
        // The head: a chevron on the arc's start, tangent to the ring — at
        // 315° the clockwise tangent points 45° down-right, so the barbs sit
        // back along that line and open perpendicular to it. Without the
        // arrowhead the ring is a "C"; with it, the direction is the whole
        // message.
        MoveTo { x: 14.82; y: 6.64; } LineTo { x: 17.94; y: 7.48; }
        LineTo { x: 17.10; y: 4.36; }
    }
}

// The sync mark itself (the sidebar's 同步 row): two arrows round each other.
// Drawn rather than typed for the same reason as `IcRefresh` above — the glyphs
// this could have borrowed are outside the font chain this shell draws in.
component IcSync {
    in property <brush> color: Colors.text-secondary;
    in property <length> size: 16px;
    width: size; height: size;
    Path {
        width: parent.width; height: parent.height;
        viewbox-x: 0; viewbox-y: 0; viewbox-width: 24; viewbox-height: 24;
        stroke: color; stroke-width: 1.8px;
        stroke-line-cap: round; stroke-line-join: round;
        fill: transparent;
        // two arrows round each other, the transfer mark
        MoveTo { x: 3.5; y: 9.5; }
        ArcTo { radius-x: 5.5; radius-y: 5.5; x: 15; y: 5.2; }
        LineTo { x: 19.5; y: 9.2; } LineTo { x: 12.5; y: 9.4; }
        MoveTo { x: 20.5; y: 14.5; }
        ArcTo { radius-x: 5.5; radius-y: 5.5; x: 9; y: 18.8; }
        LineTo { x: 4.5; y: 14.8; } LineTo { x: 11.5; y: 14.6; }
    }
}

export component Icon {
    in property <string> name;
    in property <length> size: 16px;
    in property <brush> color: Colors.text-secondary;
    in property <length> stroke-width: 1.8px; // accepted for API symmetry; primitives carry their own

    width: root.size;
    height: root.size;

    IcSearch { visible: root.name == "search"; size: root.size; color: root.color; }
    IcChevronRight { visible: root.name == "chevron-right"; size: root.size; color: root.color; }
    IcChevronDown { visible: root.name == "chevron-down"; size: root.size; color: root.color; }
    IcChevronUp { visible: root.name == "chevron-up"; size: root.size; color: root.color; }
    IcChevronLeft { visible: root.name == "chevron-left"; size: root.size; color: root.color; }
    IcPencil { visible: root.name == "pencil"; size: root.size; color: root.color; }
    IcCopy { visible: root.name == "copy"; size: root.size; color: root.color; }
    IcTrash { visible: root.name == "trash"; size: root.size; color: root.color; }
    IcPlus { visible: root.name == "plus"; size: root.size; color: root.color; }
    IcMinus { visible: root.name == "minus"; size: root.size; color: root.color; }
    IcX { visible: root.name == "x"; size: root.size; color: root.color; }
    IcGrip { visible: root.name == "grip"; size: root.size; color: root.color; }
    IcDotsHorizontal { visible: root.name == "dots-horizontal"; size: root.size; color: root.color; }
    IcSettings { visible: root.name == "settings"; size: root.size; color: root.color; }
    IcSun { visible: root.name == "sun"; size: root.size; color: root.color; }
    IcMoon { visible: root.name == "moon"; size: root.size; color: root.color; }
    IcPanelLeft { visible: root.name == "panel-left"; size: root.size; color: root.color; }
    IcPage { visible: root.name == "page"; size: root.size; color: root.color; }
    IcStar { visible: root.name == "star"; size: root.size; color: root.color; }
    IcClock { visible: root.name == "clock"; size: root.size; color: root.color; }
    IcMinimize { visible: root.name == "minimize"; size: root.size; color: root.color; }
    IcMaximize { visible: root.name == "maximize"; size: root.size; color: root.color; }
    IcRestore { visible: root.name == "restore"; size: root.size; color: root.color; }
    IcTodoCheck { visible: root.name == "todo-check"; size: root.size; color: root.color; }
    IcExport { visible: root.name == "export"; size: root.size; color: root.color; }
    IcImport { visible: root.name == "import"; size: root.size; color: root.color; }
    IcLink { visible: root.name == "link"; size: root.size; color: root.color; }
    IcImage { visible: root.name == "image"; size: root.size; color: root.color; }
    IcArrowLeft { visible: root.name == "arrow-left"; size: root.size; color: root.color; }
    IcArrowRight { visible: root.name == "arrow-right"; size: root.size; color: root.color; }
    IcPalette { visible: root.name == "palette"; size: root.size; color: root.color; }
    IcSmile { visible: root.name == "smile"; size: root.size; color: root.color; }
    IcLock { visible: root.name == "lock"; size: root.size; color: root.color; }
    IcNote { visible: root.name == "note"; size: root.size; color: root.color; }
    IcSend { visible: root.name == "send"; size: root.size; color: root.color; }
    IcRefresh { visible: root.name == "refresh"; size: root.size; color: root.color; }
    IcSync { visible: root.name == "sync"; size: root.size; color: root.color; }
}
