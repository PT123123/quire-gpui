        stroke-line-cap: round; stroke-line-join: round;
        fill: transparent;
        MoveTo { x: 20; y: 14.5; }
        ArcTo { radius-x: 8.5; radius-y: 8.5; x: 9.5; y: 4; large-arc: true; sweep: false; }
        ArcTo { radius-x: 7; radius-y: 7; x: 20; y: 14.5; large-arc: true; sweep: false; }
    }
}

component IcPanelLeft {
