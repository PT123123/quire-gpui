component IcGrip {
    in property <brush> color: Colors.text-secondary;
    in property <length> size: 16px;
    width: size; height: size;
    Path {
        width: parent.width; height: parent.height;
        viewbox-x: 0; viewbox-y: 0; viewbox-width: 24; viewbox-height: 24;
        stroke: color; stroke-width: 2.2px; stroke-line-cap: round;
        fill: transparent;
        // short segments (not zero-length): zero-area paths drop out of the
        // software renderer's rasterizer even with round caps
        MoveTo { x: 9; y: 5.4; } LineTo { x: 9; y: 6.6; }
        MoveTo { x: 9; y: 11.4; } LineTo { x: 9; y: 12.6; }
        MoveTo { x: 9; y: 17.4; } LineTo { x: 9; y: 18.6; }
        MoveTo { x: 15; y: 5.4; } LineTo { x: 15; y: 6.6; }
        MoveTo { x: 15; y: 11.4; } LineTo { x: 15; y: 12.6; }
        MoveTo { x: 15; y: 17.4; } LineTo { x: 15; y: 18.6; }
    }
}

