// The table view of a database block (SPEC §三十九 「视图」, ADR-0060/0064/0067).
//
// This component is the *whole* block body: the view switcher, the column
// header, and the realized rows. Three things about it are decisions rather than
// drawing, and each one is why a database can sit inside a page at all:
//
// 1. **The rows here are a window, not the table.** `block.db-rows` holds the
//    rows the viewport asked for (31 of 10 000 at the default geometry) and
//    `block.db-row-start` says where that slice begins. Each row is placed at
//    its true `y` — `header + (start + index) * row-height` — so the block is as
//    tall as the database and the rows appear where a reader expects them, while
//    the objects that exist are only the ones on screen (ADR-0067, SPEC's first
//    red line). The row→model conversion is that expression and nothing else:
//    model index `i` is row `start + i`, and no delegate ever guesses which one
//    it has been handed.
//
// 2. **The scroll is the page's scroll.** There is no second scroll region: the
//    block grows to the table's height and the editor's own `ListView` scrolls
//    it, so the realized rows are the ones the page viewport can see. Rust
//    cannot see Slint's layout, so this component *reports* where its top is
//    relative to the viewport (`top-in-view`, below) and Rust turns that into
//    the window. The alternative — a nested scroll area — is the one shape this
//    project refuses on principle: a wheel that scrolls an inner list instead of
//    the page is a trap, not a feature.
//
// 3. **Column widths are permille, and the layout divides them.** A stored width
//    is a fraction of the grid (ADR-0064's `widths` map), so a fixed column gets
//    an explicit pixel width and an "auto" one (permille 0) gets an equal share
//    of what is left — through `horizontal-stretch`, because Slint has no fold
//    to sum the fixed widths inside a binding. Header and rows use the same
//    expression, which is what keeps the columns aligned.
//
// What is deliberately *not* here: adding or reordering a property, and the
// other seven layouts. D4 added the rules' UI — the filter button and its
// panel, the header-click sort with its arrow, the group-by picker, the group
// header entries between the rows — and every one of those controls only
// *sends* a decision: the rules are written back into the view's document and
// compiled into SQL, so what a row shows is the query's answer, never a
// Rust- or Slint-side filter. A row menu beyond delete, and the layouts, are
// D5. `db-layout-ok` is why a view this build cannot draw says so instead of
// pretending to be a table.

import { Theme } from "../Theme.slint";
import { Colors } from "../Colors.slint";
import { Typography } from "../Typography.slint";
import { Icon } from "../Icons.slint";
import { UIState, BlockRow, DbBoardColumn, DbCalendarDay, DbFormField } from "../Types.slint";
import { DatabaseCell } from "./DatabaseCell.slint";
import { DatabaseSwitcher } from "./DatabaseSwitcher.slint";

export component DatabaseView inherits Rectangle {
    in property <BlockRow> block;
    in property <length> content-width;
    in property <length> row-y; // the block body's top, in list-content coords

    // ── D5: which layout is drawn, and the shape it is drawn at ──────────
    // The active view's `db_views.layout` decides which body arm below draws,
    // and — with it — what a "unit" of the scroll surface is: a table row, a
    // list row, a timeline lane, a board slot, a gallery card row. The heights
    // are not restated here: `db-row-height` is the layout's own unit (Rust's
    // `layout_metrics`), and `db-body-height` is the whole surface below the
    // header, computed in Rust from the layout's counts. The block's height is
    // the header plus that surface (floored at the empty-state's one line),
    // which is what keeps the page's scroll the view's scroll for every
    // layout — the red line is about rows, and each layout's window is its own
    // answer to it.
    // The eight are Rust's `ViewLayout::ALL` indices, not words: `db-layout` is
    // the switcher's label ("Table", capital), and these predicates were written
    // against the store's lowercase keys — so every arm below was false, the
    // header drew, and the body of every layout was blank for six slices. A
    // number cannot drift away from a display string because it is not one.
    property <int> layout: root.block.db-layout-index;
    property <bool> is-table: root.layout == 0;
    property <bool> is-board: root.layout == 1;
    property <bool> is-list: root.layout == 2;
    property <bool> is-calendar: root.layout == 3;
    property <bool> is-gallery: root.layout == 4;
    property <bool> is-timeline: root.layout == 5;
    property <bool> is-form: root.layout == 6;
    property <bool> is-chart: root.layout == 7;
    // The three layouts that place one row per unit and share the row
    // rectangle below; the others draw their own body arms.
    property <bool> row-based: root.is-table || root.is-list || root.is-timeline;
    // The layouts whose empty state is the delegate's own body (a calendar
    // with no records is a month of blanks; a form is always its fields; a
    // chart says "pick a column to group by" inside its plot).
    property <bool> shows-empty-state: !root.is-calendar && !root.is-form && !root.is-chart;
    // D7: the view's search box, open on this block (the session state is
    // one box at a time, keyed by block id — the same shape the popups use).
    property <bool> search-open: UIState.db-search-open
        && UIState.db-search-block == root.block.id;

    // The page scroll, and this block's place in it: where the viewport's top
    // edge falls inside this block, in px. Negative when the block's top is
    // above the viewport, positive when it starts below it. Reported to
    // Rust whenever it moves — a scroll, a reflow, a page switch — and it is the
    // *only* piece of layout this slice lets Rust depend on.
    property <length> top-in-view: root.row-y - UIState.editor-scroll-y;
    changed top-in-view => {
        UIState.db-viewport(root.block.id, root.top-in-view);
    }

    // The scroll surface: the header plus the layout's surface below it. An
    // empty database (except the calendar and the form, which draw their own
    // bodies) reserves one line for its "no rows" text, so the block is never
    // zero-height and always clickable.
    property <length> body-top: root.block.db-header-height;
    property <length> body-h: Math.max(root.block.db-body-height, 0px);
    property <length> empty-h: 34px;
    property <bool> has-rows: root.block.db-row-count > 0;
    height: root.body-top
        + (root.has-rows || !root.shows-empty-state
            ? Math.max(root.body-h, 0px)
            : root.empty-h);

    // The columns' grid: the row-action slot is reserved on both the header and
    // the rows, which is what keeps their columns aligned.
    property <length> slot-w: 22px;
    property <length> grid-w: Math.max(root.content-width - root.slot-w, 40px);
    property <int> drag-col: -1;
    property <length> drag-dx: 0px;
    // [T2 unblock fix] PointerEvent 没有 delta-x 字段（那是 scroll 事件才有），
    // 改用 TouchArea.pressed-x 手动求差；只是让编译通过，拖拽语义不变。
    property <length> drag-last-x: 0px;
    property <bool> live: block.db-ok && block.db-layout-ok;
    // A view whose layout is not drawn still names itself; the label is the
    // view's `db_views.layout` as a word (ADR-0060's fold, on screen).
    property <bool> foreign: block.db-ok && !block.db-layout-ok;

    // The width of one column: a permille of the grid, which Rust has already
    // resolved — an "auto" column arrives here with its equal share of what the
    // dragged ones left, because a delegate cannot fold a list and a `width`
    // binding beats `horizontal-stretch` in a layout.
    function col-w(index: int) -> length {
        root.grid-w * root.block.db-columns[index].permille / 1000
    }

    background: transparent;

    // ── the block has no entity: ADR-0060's "(deleted database)" ─────────
    // One muted line, exactly as a dangling `page_ref` draws. The block is still
    // a block: hiding it would silently take a row out of the page.
    if !block.db-ok : Text {
        x: 0px;
        y: Theme.spacing-md;
        width: root.content-width;
        height: 24px;
        vertical-alignment: center;
        text: "（已删除的数据库）";
        font-family: Typography.ui-font;
        font-size: Typography.size-ui;
        color: Colors.text-muted;
    }

    // ── the header: the views, the actions, and the column names ──────────
    if root.live : Rectangle {
        x: 0px;
        y: 0px;
        width: root.content-width;
        height: root.body-top;
        background: transparent;

        DatabaseSwitcher {
            x: 0px;
            y: 4px;
            tabs: root.block.db-views;
            block: root.block.id;
        }

        // How many rows there are, in words: a 10 000-row table's scroll bar
        // cannot say it, and the switcher line has the room. Right-aligned
        // against the buttons, which are fixed-width. D4: when the view has a
        // visible degradation (`db-filter-note` — a filter the document held
        // that this build could not apply), the note takes the count's place,
        // in the color that says "read this": a count of rows the user is not
        // seeing is exactly the wrong thing to display there.
        if root.block.db-filter-note != "" : Text {
            x: parent.width - 552px;
            y: 4px;
            width: 228px;
            height: 22px;
            vertical-alignment: center;
            overflow: elide;
            text: root.block.db-filter-note;
            font-family: Typography.ui-font;
            font-size: Typography.size-caption;
            color: Colors.danger;
        }
        // The count is also the search's home (D7): closed, it is the words
        // it always was, clickable to open the box; open, the box takes the
        // slot and stretches left into the switcher line's free space. The
        // degraded-rules note keeps its slot in both states — a filter that
        // is not being applied outranks a search box.
        if root.block.db-filter-note == "" && !root.search-open : Rectangle {
            x: parent.width - 316px - 92px;
            y: 4px;
            width: 88px;
            height: 22px;
            border-radius: Theme.radius-sm;
            background: count-ta.has-hover ? Colors.surface-hover : transparent;

            Text {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;
                vertical-alignment: center;
                horizontal-alignment: right;
                text: root.block.db-row-count + " 行";
                font-family: Typography.ui-font;
                font-size: Typography.size-caption;
                color: Colors.text-muted;
            }
            count-ta := TouchArea {
                width: parent.width;
                height: parent.height;
                mouse-cursor: MouseCursor.pointer;
                clicked => {
                    UIState.db-search-opened(root.block.id);
                }
            }
        }
        if root.search-open : Rectangle {
            x: parent.width - 476px;
            y: 4px;
            width: 156px;
            height: 22px;
            border-radius: Theme.radius-sm;
            background: Colors.surface-hover;
            border-width: 1px;
            border-color: Colors.border-strong;

            // the muted word behind the empty box: what it is and that it
            // narrows what the header counts
            if UIState.db-search-text == "" : Text {
                x: 10px;
                y: 0px;
                width: parent.width - 26px;
                height: parent.height;
                vertical-alignment: center;
                text: "搜索此视图";
                font-family: Typography.ui-font;
                font-size: Typography.size-caption;
                color: Colors.text-muted;
            }
            search-input := TextInput {
                x: 10px;
                y: 0px;
                width: parent.width - 26px;
                height: parent.height;
                vertical-alignment: center;
                font-family: Typography.ui-font;
                font-size: Typography.size-caption;
                color: Colors.text-primary;
                text: UIState.db-search-text;
                // per keystroke: the needle is a read's input — no change, no
                // undo step; the count and the rows move with it
                edited => {
                    UIState.db-search-text-set(root.block.id, self.text);
                }
                // Enter accepts and keeps the box; the x closes and clears
                accepted => {
                    UIState.db-search-text-set(root.block.id, self.text);
                }
                // the box exists because the user clicked the count: the
                // caret is already theirs
                init => {
                    self.focus();
                }
            }
            // close and clear: an invisible predicate on a visible table is
            // a state the header's count could not explain
            Rectangle {
                x: parent.width - 16px;
                y: (parent.height - 12px) / 2;
                width: 12px;
                height: 12px;
                border-radius: 6px;
                background: search-x-ta.has-hover ? Colors.border-strong : transparent;

                Text {
                    x: 0px;
                    y: -2px;
                    width: parent.width;
                    height: parent.height;
                    text: "x";
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    font-size: 9px;
                    color: search-x-ta.has-hover ? Colors.text-primary : Colors.text-muted;
                }
                search-x-ta := TouchArea {
                    width: parent.width;
                    height: parent.height;
                    mouse-cursor: MouseCursor.pointer;
                    clicked => {
                        UIState.db-search-closed(root.block.id);
                    }
                }
            }
        }

        // "New row": the one row action that is not per-row. It lives in the
        // header rather than under the last row, because a 10 000-row database
        // has no reachable last row.
        new-row := Rectangle {
            x: parent.width - 224px - 92px;
            y: 4px;
            width: 92px;
            height: 22px;
            border-radius: Theme.radius-sm;
            background: new-row-ta.has-hover ? Colors.surface-hover : transparent;

            Icon {
                x: 4px;
                y: 4px;
                width: 14px;
                height: 14px;
                size: 14px;
                name: "plus";
                color: Colors.text-secondary;
            }
            Text {
                x: 22px;
                y: 0px;
                height: parent.height;
                vertical-alignment: center;
                text: "新建行";
                font-family: Typography.ui-font;
                font-size: Typography.size-caption;
                color: Colors.text-secondary;
            }
            new-row-ta := TouchArea {
                width: parent.width;
                height: parent.height;
                mouse-cursor: MouseCursor.pointer;
                clicked => {
                    UIState.db-row-added(root.block.id);
                }
            }
        }

        // "Columns": the visible-column list (SPEC §三十九's 隐藏列). A window
        // popup and not an inline menu, because a menu drawn inside a row would
        // be clipped by the list view it sits in.
        columns-btn := Rectangle {
            x: parent.width - 224px;
            y: 4px;
            width: 96px;
            height: 22px;
            border-radius: Theme.radius-sm;
            background: columns-ta.has-hover ? Colors.surface-hover : transparent;

            Icon {
                x: 4px;
                y: 4px;
                width: 14px;
                height: 14px;
                size: 14px;
                name: "minimize";
                color: Colors.text-secondary;
            }
            Text {
                x: 22px;
                y: 0px;
                height: parent.height;
                vertical-alignment: center;
                text: "列";
                font-family: Typography.ui-font;
                font-size: Typography.size-caption;
                color: Colors.text-secondary;
            }
            columns-ta := TouchArea {
                width: parent.width;
                height: parent.height;
                mouse-cursor: MouseCursor.pointer;
                clicked => {
                    // anchored just under the button, in *window* coordinates:
                    // the popup lives at the window root (slint rule), and
                    // `absolute-position` is the element's position relative
                    // to that window — scroll and sidebar included, so the
                    // controller has no geometry of its own to add. The
                    // controller still clamps (the last rows must not open
                    // off the bottom).
                    UIState.db-columns-opened(
                        root.block.id,
                        self.absolute-position.x,
                        self.absolute-position.y + self.height);
                }
            }
        }

        // "Filter": the view's rules (D4). The count chip is how many clauses
        // the filter holds, and the accent color is the "this view is
        // filtered" state — the same signal the note line borrows when the
        // rules could not be applied.
        filter-btn := Rectangle {
            x: parent.width - 128px;
            y: 4px;
            width: 64px;
            height: 22px;
            border-radius: Theme.radius-sm;
            background: root.block.db-filter-count > 0 ? Colors.accent-soft
                : filter-ta.has-hover ? Colors.surface-hover : transparent;

            Text {
                x: 6px;
                width: parent.width - 12px;
                height: parent.height;
                vertical-alignment: center;
                horizontal-alignment: center;
                text: root.block.db-filter-count > 0
                    ? "筛选 " + root.block.db-filter-count
                    : "筛选";
                font-family: Typography.ui-font;
                font-size: Typography.size-caption;
                color: root.block.db-filter-count > 0 ? Colors.accent-text : Colors.text-secondary;
            }
            filter-ta := TouchArea {
                width: parent.width;
                height: parent.height;
                mouse-cursor: MouseCursor.pointer;
                clicked => {
                    UIState.db-filter-opened(
                        root.block.id,
                        self.absolute-position.x,
                        self.absolute-position.y + self.height);
                }
            }
        }

        // "Group": the group-by picker (D4). Accent when a column is grouped;
        // the picker itself offers only the option-bounded kinds, because the
        // list of group headers has to stay small enough to compute in full
        // (ADR-0076) — grouping by a text column would put a header on every
        // distinct value, which is the one thing group-by must not become.
        group-btn := Rectangle {
            x: parent.width - 64px;
            y: 4px;
            width: 64px;
            height: 22px;
            border-radius: Theme.radius-sm;
            background: root.block.db-group-property >= 0 ? Colors.accent-soft
                : group-ta.has-hover ? Colors.surface-hover : transparent;

            Text {
                x: 6px;
                width: parent.width - 12px;
                height: parent.height;
                vertical-alignment: center;
                horizontal-alignment: center;
                text: "分组";
                font-family: Typography.ui-font;
                font-size: Typography.size-caption;
                color: root.block.db-group-property >= 0 ? Colors.accent-text : Colors.text-secondary;
            }
            group-ta := TouchArea {
                width: parent.width;
                height: parent.height;
                mouse-cursor: MouseCursor.pointer;
                clicked => {
                    UIState.db-group-opened(
                        root.block.id,
                        self.absolute-position.x,
                        self.absolute-position.y + self.height);
                }
            }
        }

        // the column names, one per visible column, in view order
        HorizontalLayout {
            x: 0px;
            y: root.body-top - 34px;
            width: root.grid-w;
            height: 34px;
            spacing: 0px;

            for column[index] in root.block.db-columns : Rectangle {
                width: root.col-w(index);
                background: head-ta.has-hover ? Colors.surface-hover : transparent;
                border-width: 1px;
                border-color: Colors.border;

                // The sort indicator's state (D4): the first term of the view's
                // sort list, which is the one the header edits. A document may
                // name more terms and still sorts by all of them — this arrow
                // is the head of that order, and cycling it is the one sort
                // edit a header can honestly offer.
                property <bool> is-sorted: root.block.db-sort-property == column.property;

                Text {
                    x: Theme.spacing-sm;
                    y: 0px;
                    width: parent.width - 2 * Theme.spacing-sm - (parent.is-sorted ? 14px : 0px);
                    height: parent.height;
                    vertical-alignment: center;
                    overflow: elide;
                    text: column.name;
                    font-family: Typography.ui-font;
                    font-size: Typography.size-caption;
                    font-weight: Typography.weight-semibold;
                    color: Colors.text-secondary;
                }

                if is-sorted : Icon {
                    x: parent.width - 18px;
                    y: (parent.height - 12px) / 2;
                    width: 12px;
                    height: 12px;
                    size: 12px;
                    name: root.block.db-sort-desc ? "chevron-down" : "chevron-up";
                    color: Colors.accent-text;
                }

                head-ta := TouchArea {
                    width: parent.width - 6px;
                    height: parent.height;
                    mouse-cursor: MouseCursor.pointer;
                    // cycle none → ascending → descending → none; a kind with
                    // no order (a multi-select, a formula) refuses in Rust and
                    // the header stays as it was
                    clicked => {
                        UIState.db-sort-cycled(root.block.id, column.property);
                    }
                }

                // The resize handle: a 6 px strip on the column's trailing edge.
                // The width is applied **on release**, and the drag paints a
                // guide instead — a per-move write would be a SQL write per
                // frame, and a per-move re-projection would rebuild the window
                // the reader is looking at.
                resize := TouchArea {
                    x: parent.width - 6px;
                    width: 6px;
                    height: parent.height;
                    mouse-cursor: MouseCursor.pointer;
                    pointer-event(e) => {
                        if (e.kind == PointerEventKind.down) {
                            root.drag-col = index;
                            root.drag-dx = 0px;
                            root.drag-last-x = self.pressed-x;
                        } else if (e.kind == PointerEventKind.move) {
                            if (root.drag-col == index) {
                                root.drag-dx += self.pressed-x - root.drag-last-x;
                                root.drag-last-x = self.pressed-x;
                            }
                        } else if (e.kind == PointerEventKind.up) {
                            if (root.drag-col == index) {
                                root.drag-dx += self.pressed-x - root.drag-last-x;
                                root.drag-last-x = self.pressed-x;
                                // the resolved width of this column, which the
                                // layout already knows (which is why the handle
                                // lives inside it) plus what the drag moved
                                UIState.db-column-resized(
                                    root.block.id,
                                    column.property,
                                    Math.round((parent.width + root.drag-dx) * 1000 / root.grid-w));
                                root.drag-col = -1;
                                root.drag-dx = 0px;
                            }
                        }
                    }
                }

                // where the edge would land if the drag were released now
                if root.drag-col == index : Rectangle {
                    x: parent.width + root.drag-dx - 1px;
                    y: 0px;
                    width: 2px;
                    height: parent.height;
                    background: Colors.accent;
                }
            }
        }
    }

    // ── the rows (table / list / timeline: one row per window unit) ───────
    // One element per realized row, placed at its own offset in the scroll
    // surface: `db-row-start` is what makes `index` a *model* index and the
    // position a *row* index (§三十七's two extra rules for a block whose rows
    // are dynamic). Deliberately not clipped — a select cell's option list is
    // taller than the row it belongs to, and the list view clips to the viewport
    // anyway.
    if root.live && root.row-based : Rectangle {
        x: 0px;
        y: root.body-top;
        width: root.content-width;
        height: root.has-rows ? root.body-h : root.empty-h;
        background: transparent;

        for row[index] in root.block.db-rows : Rectangle {
            x: 0px;
            y: (root.block.db-row-start + index) * root.block.db-row-height;
            width: parent.width;
            height: root.block.db-row-height;
            background: transparent;

            // ── a group header (D4): one muted line, an *entry* and not a
            // record. It occupies one slot of the scroll surface the window
            // arithmetic already accounted for (`group_window` placed it
            // here), carries no cells and no row actions, and its label came
            // from Rust with the count already in it — the delegate draws
            // words, it does not count rows.
            if row.header != "" : Rectangle {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;
                background: Colors.surface-hover;

                Text {
                    x: Theme.spacing-sm;
                    y: 0px;
                    width: parent.width - 2 * Theme.spacing-sm;
                    height: parent.height;
                    vertical-alignment: center;
                    overflow: elide;
                    text: row.header;
                    font-family: Typography.ui-font;
                    font-size: Typography.size-caption;
                    font-weight: Typography.weight-semibold;
                    color: Colors.text-secondary;
                }
            }

            // ── a table row: the cell grid (D3) ────────────────────────────
            if row.header == "" && root.is-table : HorizontalLayout {
                x: 0px;
                y: 0px;
                width: root.grid-w;
                height: parent.height;
                spacing: 0px;

                for cell[ci] in row.cells : DatabaseCell {
                    width: root.col-w(ci);
                    height: parent.height;
                    cell: cell;
                    column: root.block.db-columns[ci];
                    record: row.record;
                    block: root.block.id;
                }
            }

            // ── a list row (D5): the title on its own line, the first two
            // visible columns as a muted preview underneath. Opening is the
            // row's whole click: a page-backed record navigates, a bare one
            // mints its page first (ADR-0063's lazy page, `db-open-record`) —
            // which is why the click is on the row, not in a cell.
            if row.header == "" && root.is-list : Rectangle {
                x: 0px;
                y: 0px;
                width: root.grid-w;
                height: parent.height;
                background: list-ta.has-hover ? Colors.surface-hover : transparent;

                Text {
                    x: Theme.spacing-sm;
                    y: 4px;
                    width: parent.width - 2 * Theme.spacing-sm;
                    height: 18px;
                    vertical-alignment: center;
                    overflow: elide;
                    text: row.title;
                    font-family: Typography.ui-font;
                    font-size: Typography.size-ui;
                    color: Colors.text-primary;
                }
                Text {
                    x: Theme.spacing-sm;
                    y: 22px;
                    width: parent.width - 2 * Theme.spacing-sm;
                    height: 16px;
                    vertical-alignment: center;
                    overflow: elide;
                    // the painted cells, joined: two columns of preview, and
                    // "" when the view shows nothing but the title
                    text: row.cells.length > 0
                        ? (row.cells[0].text + (row.cells.length > 1 ? " · " + row.cells[1].text : ""))
                        : "";
                    font-family: Typography.ui-font;
                    font-size: Typography.size-caption;
                    color: Colors.text-muted;
                }
                list-ta := TouchArea {
                    width: parent.width;
                    height: parent.height;
                    mouse-cursor: MouseCursor.pointer;
                    clicked => {
                        UIState.db-open-record(root.block.id, row.record);
                    }
                }
            }

            // ── a timeline lane (D5): the bar at its days' place on the axis.
            // The axis is Rust's (`db-tl-start` / `db-tl-days`, one aggregate
            // query), the bar's days are the row's (`tl-from` / `tl-to`) — the
            // delegate does the one mapping and nothing else. A same-day bar
            // is a point (a 6 px pill), the brief's 「起=止=同一天时画点」.
            if row.header == "" && root.is-timeline : Rectangle {
                x: 0px;
                y: 0px;
                width: root.grid-w;
                height: parent.height;
                background: transparent;

                property <length> day-w: root.grid-w / Math.max(root.block.db-tl-days, 1);
                property <length> bar-x: (row.tl-from - root.block.db-tl-start) * self.day-w;
                property <length> bar-w: Math.max(
                    (row.tl-to - row.tl-from + 1) * self.day-w, 6px);

                // the lane's own line, so a bar's height reads against something
                Rectangle {
                    x: 0px;
                    y: (parent.height - 1px) / 2;
                    width: parent.width;
                    height: 1px;
                    background: Colors.border;
                }
                if row.tl-from >= 0 : Rectangle {
                    x: parent.bar-x;
                    y: (parent.height - 12px) / 2;
                    width: parent.bar-w;
                    height: 12px;
                    border-radius: 6px;
                    background: Colors.accent;
                }
                Text {
                    x: parent.bar-x + parent.bar-w + 8px;
                    y: 0px;
                    width: Math.max(parent.width - parent.bar-x - parent.bar-w - 16px, 40px);
                    height: parent.height;
                    vertical-alignment: center;
                    overflow: elide;
                    text: row.title;
                    font-family: Typography.ui-font;
                    font-size: Typography.size-caption;
                    color: Colors.text-secondary;
                }
            }

            // The row's own actions, in the slot both the header and the rows
            // reserve. Delete is ADR-0063's plan (`[values, record, page?]`, one
            // Ctrl+Z); the template (D7, ADR-0086) is the other — this row's
            // values become the prefill every later "New row" starts from, so
            // "T" on a row copies it and "T" on an empty row clears the
            // template. Renaming a row is editing its title cell, and opening
            // one as a page is the row's click in a list (above). A group
            // header has neither action — its slot stays empty.
            if row.header == "" : Rectangle {
                x: root.grid-w;
                width: root.slot-w;
                height: parent.height;
                background: transparent;

                Text {
                    x: 0px;
                    y: 0px;
                    width: parent.width / 2;
                    height: parent.height;
                    text: "T";
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    font-size: 9px;
                    // only on hover: a row that always shows its actions is a
                    // row of noise, and these are two small targets
                    color: tpl-ta.has-hover ? Colors.accent : Colors.text-muted;
                    opacity: tpl-ta.has-hover || del-ta.has-hover ? 1.0 : 0.0;
                }
                tpl-ta := TouchArea {
                    x: 0px;
                    width: parent.width / 2;
                    height: parent.height;
                    mouse-cursor: MouseCursor.pointer;
                    clicked => {
                        UIState.db-template-saved(root.block.id, row.record);
                    }
                }
                Text {
                    x: parent.width / 2;
                    y: 0px;
                    width: parent.width / 2;
                    height: parent.height;
                    text: "x";
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    font-size: Typography.size-caption;
                    color: del-ta.has-hover ? Colors.danger : Colors.text-muted;
                    opacity: tpl-ta.has-hover || del-ta.has-hover ? 1.0 : 0.0;
                }
                del-ta := TouchArea {
                    x: parent.width / 2;
                    width: parent.width / 2;
                    height: parent.height;
                    mouse-cursor: MouseCursor.pointer;
                    clicked => {
                        UIState.db-row-removed(root.block.id, row.record);
                    }
                }
            }
        }

        // an empty database says so and offers its first row, in the place the
        // rows would start (the calendar and the form draw their own bodies,
        // so this arm is theirs to skip)
        if !root.has-rows && root.shows-empty-state : Rectangle {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: root.empty-h;
            background: empty-ta.has-hover ? Colors.surface-hover : transparent;

            Text {
                x: Theme.spacing-sm;
                y: 0px;
                height: parent.height;
                vertical-alignment: center;
                text: "还没有行 - 新建行即可添加";
                font-family: Typography.ui-font;
                font-size: Typography.size-caption;
                color: Colors.text-muted;
            }
            empty-ta := TouchArea {
                width: parent.width;
                height: parent.height;
                mouse-cursor: MouseCursor.pointer;
                clicked => {
                    UIState.db-row-added(root.block.id);
                }
            }
        }
    }

    // ── a board (D5): columns are groups, cards are records ──────────────
    // The columns are the group list (a handful of headers from one `GROUP
    // BY`); each holds its own slice of the slot window the Rust side
    // computed (`board_window`), and a card is placed at
    // `(db-row-start + index) * db-row-height` inside its column — the same
    // row→slot conversion the table's rows use, one unit down. A column
    // holding 10 000 cards realizes the same handful the ungrouped table
    // would; a card is a title and the first checkbox cell it was handed.
    if root.live && root.is-board : Rectangle {
        x: 0px;
        y: root.body-top;
        width: root.content-width;
        height: root.body-h;
        background: transparent;

        HorizontalLayout {
            x: 0px;
            y: 0px;
            width: root.grid-w;
            height: parent.height;
            spacing: Theme.spacing-sm;

            for column[ci] in root.block.db-board-columns : Rectangle {
                horizontal-stretch: 1;
                height: parent.height;
                background: transparent;

                Text {
                    x: Theme.spacing-sm;
                    y: 0px;
                    width: parent.width - 2 * Theme.spacing-sm;
                    height: 24px;
                    vertical-alignment: center;
                    overflow: elide;
                    // the label came with the count in it from Rust ("Done · 3",
                    // the group header's own wording) — the delegate draws words
                    text: column.label;
                    font-family: Typography.ui-font;
                    font-size: Typography.size-caption;
                    font-weight: Typography.weight-semibold;
                    color: Colors.text-secondary;
                }

                // the card area: the whole surface's height, so every column's
                // slot grid is the same height and a card's y is its true slot
                Rectangle {
                    x: 0px;
                    y: 24px;
                    width: parent.width;
                    height: Math.max(parent.height - 24px, 0px);
                    background: transparent;

                    for card[index] in column.cards : Rectangle {
                        x: Theme.spacing-sm;
                        y: (root.block.db-row-start + index) * root.block.db-row-height;
                        width: parent.width - 2 * Theme.spacing-sm;
                        height: root.block.db-row-height - 8px;
                        border-radius: Theme.radius-sm;
                        background: Colors.surface;
                        border-width: 1px;
                        border-color: Colors.border;

                        // the card's words, clickable: a page-backed card
                        // navigates, a bare one mints its page first
                        // (ADR-0063's lazy page) — the same Open a list row's
                        // click is
                        card-ta := TouchArea {
                            width: parent.width;
                            height: parent.height;
                            mouse-cursor: MouseCursor.pointer;
                            clicked => {
                                UIState.db-open-record(root.block.id, card.record);
                            }
                        }

                        Text {
                            x: Theme.spacing-sm;
                            y: 8px;
                            width: parent.width - 2 * Theme.spacing-sm;
                            height: 20px;
                            vertical-alignment: center;
                            overflow: elide;
                            text: card.title;
                            font-family: Typography.ui-font;
                            font-size: Typography.size-caption;
                            color: Colors.text-primary;
                        }

                        // the card's checkboxes: the checkbox cells the row was
                        // handed, drawn as the box the cell draws and toggled
                        // through the **same write path** (`db-cell-toggled`,
                        // `Flag(!shown)`) — a board card is a record, and its
                        // box must not invent a second one
                        HorizontalLayout {
                            x: Theme.spacing-sm;
                            y: 34px;
                            width: parent.width - 2 * Theme.spacing-sm;
                            height: 20px;
                            spacing: Theme.spacing-xs;

                            // Slint's for-body must be one element — a
                            // conditional cannot chain after the colon — so
                            // the non-checkbox cells ride along as zero-width
                            // invisible boxes.
                            for cell[ci] in card.cells : Rectangle {
                                visible: cell.kind == 7;
                                width: cell.kind == 7 ? 16px : 0px;
                                height: 16px;
                                border-radius: Theme.radius-xs;
                                border-width: 1.5px;
                                border-color: cell.checked ? Colors.accent : Colors.border-strong;
                                background: cell.checked ? Colors.accent : transparent;

                                if cell.checked : Text {
                                    x: 0px;
                                    y: -1px;
                                    width: parent.width;
                                    height: parent.height;
                                    text: "v";
                                    font-size: 11px;
                                    font-weight: Typography.weight-bold;
                                    color: Colors.text-on-accent;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                                box-ta := TouchArea {
                                    width: parent.width;
                                    height: parent.height;
                                    mouse-cursor: MouseCursor.pointer;
                                    clicked => {
                                        UIState.db-cell-toggled(root.block.id, card.record, cell.property, cell.checked);
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // ── a calendar (D5): the month grid, records folded inside each day ──
    // The grid is **fixed** (six weeks of seven days) so its height does not
    // depend on the data — which is the whole reason this layout's red line is
    // about the *day cells* rather than a scroll window: a day draws at most
    // three records and says "and N more", and both numbers came from one
    // `GROUP BY` over the month (≤ 31 keys). The month's own records never all
    // become objects.
    if root.live && root.is-calendar : Rectangle {
        x: 0px;
        y: root.body-top;
        width: root.content-width;
        height: root.body-h;
        background: transparent;

        // the month strip: ‹ September 2026 › — one refresh per press
        Rectangle {
            x: 0px;
            y: 0px;
            width: root.grid-w;
            height: 28px;
            background: transparent;

            prev-btn := Rectangle {
                x: 0px;
                y: 2px;
                width: 24px;
                height: 24px;
                border-radius: Theme.radius-sm;
                background: prev-ta.has-hover ? Colors.surface-hover : transparent;

                Text {
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    height: parent.height;
                    text: "<";
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    font-size: Typography.size-caption;
                    color: Colors.text-secondary;
                }
                prev-ta := TouchArea {
                    width: parent.width;
                    height: parent.height;
                    mouse-cursor: MouseCursor.pointer;
                    clicked => {
                        UIState.db-cal-month(root.block.id, -1);
                    }
                }
            }
            Text {
                x: 32px;
                y: 0px;
                height: parent.height;
                vertical-alignment: center;
                text: root.block.db-cal-label;
                font-family: Typography.ui-font;
                font-size: Typography.size-ui;
                font-weight: Typography.weight-semibold;
                color: Colors.text-primary;
            }
            next-btn := Rectangle {
                x: parent.width - 24px;
                y: 2px;
                width: 24px;
                height: 24px;
                border-radius: Theme.radius-sm;
                background: next-ta.has-hover ? Colors.surface-hover : transparent;

                Text {
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    height: parent.height;
                    text: ">";
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    font-size: Typography.size-caption;
                    color: Colors.text-secondary;
                }
                next-ta := TouchArea {
                    width: parent.width;
                    height: parent.height;
                    mouse-cursor: MouseCursor.pointer;
                    clicked => {
                        UIState.db-cal-month(root.block.id, 1);
                    }
                }
            }
        }

        // the weekday initials, Monday first — the order `first_weekday_monday0`
        // numbers the grid's columns by
        HorizontalLayout {
            x: 0px;
            y: 28px;
            width: root.grid-w;
            height: 20px;
            spacing: 0px;

            for day in 7 : Rectangle {
                horizontal-stretch: 1;
                height: parent.height;
                background: transparent;

                Text {
                    x: Theme.spacing-xs;
                    y: 0px;
                    height: parent.height;
                    vertical-alignment: center;
                    text: ["一", "二", "三", "四", "五", "六", "日"][day];
                    font-family: Typography.ui-font;
                    font-size: Typography.size-caption;
                    color: Colors.text-muted;
                }
            }
        }

        // the grid itself: six weeks of seven cells, indexed into the model
        // Rust built (`month_cells` → the `GROUP BY`'s counts and the peeks)
        for week in 6 : HorizontalLayout {
            x: 0px;
            y: 48px + week * 96px;
            width: root.grid-w;
            height: 96px;
            spacing: 0px;

            for day in 7 : Rectangle {
                horizontal-stretch: 1;
                height: parent.height;
                background: root.block.db-cal-days[week * 7 + day].day > 0
                    ? (cell-ta.has-hover ? Colors.surface-hover : transparent)
                    : transparent;
                border-width: 1px;
                border-color: Colors.border;

                if root.block.db-cal-days[week * 7 + day].day > 0 : Text {
                    x: Theme.spacing-xs;
                    y: 2px;
                    height: 16px;
                    vertical-alignment: center;
                    text: "" + root.block.db-cal-days[week * 7 + day].day;
                    font-family: Typography.ui-font;
                    font-size: Typography.size-caption;
                    color: Colors.text-secondary;
                }
                // up to three realized records — a title each, elided
                for at in 3 : Rectangle {
                    x: 0px;
                    y: 20px + at * 16px;
                    width: parent.width;
                    height: 16px;
                    background: transparent;

                    if root.block.db-cal-days[week * 7 + day].records.length > at : Text {
                        x: Theme.spacing-xs;
                        y: 0px;
                        width: parent.width - 2 * Theme.spacing-xs;
                        height: parent.height;
                        vertical-alignment: center;
                        overflow: elide;
                        text: root.block.db-cal-days[week * 7 + day].records[at].title;
                        font-family: Typography.ui-font;
                        font-size: Typography.size-caption;
                        color: Colors.text-primary;
                    }
                }
                // the fold: what the day holds minus what it drew. The number
                // is the `GROUP BY`'s count, so the rows it names never became
                // objects.
                if root.block.db-cal-days[week * 7 + day].count > 3 : Text {
                    x: Theme.spacing-xs;
                    y: 68px;
                    width: parent.width - 2 * Theme.spacing-xs;
                    height: 16px;
                    vertical-alignment: center;
                    overflow: elide;
                    text: "还有 "
                        + (root.block.db-cal-days[week * 7 + day].count - 3)
                        + " 条";
                    font-family: Typography.ui-font;
                    font-size: Typography.size-caption;
                    color: Colors.accent-text;
                }
                cell-ta := TouchArea {
                    width: parent.width;
                    height: parent.height;
                    mouse-cursor: MouseCursor.default;
                }
            }
        }
    }

    // ── a gallery (D5): a grid of cards, windowed by card rows ───────────
    // The grid's width decides how many cards a row holds, and the shape is
    // what the *window* was computed with — so the delegate **reports** it
    // when it changes (`db-gallery-shaped`), exactly the split the scroll's
    // top-in-view follows. Each realized card is placed at its own row and
    // column from `db-row-start`; the cards' objects are the window's slice
    // (`per_row × rows`), never the grid's total.
    if root.live && root.is-gallery : Rectangle {
        x: 0px;
        y: root.body-top;
        width: root.content-width;
        height: root.body-h;
        background: transparent;

        // the shape formula: the same minimum card width Rust's
        // `gallery_per_row` uses, so the reported number and the drawn columns
        // cannot disagree
        property <int> per-row: Math.max(
            Math.floor(root.grid-w / 168px), 1);
        changed per-row => {
            UIState.db-gallery-shaped(root.block.id, per-row);
        }
        property <length> card-w: root.grid-w / Math.max(root.block.db-gallery-per-row, 1);

        for card[index] in root.block.db-rows : Rectangle {
            x: Math.mod(index, Math.max(root.block.db-gallery-per-row, 1)) * card-w;
            y: (root.block.db-row-start
                + Math.floor(index / Math.max(root.block.db-gallery-per-row, 1)))
                * root.block.db-row-height;
            width: card-w - Theme.spacing-sm;
            height: root.block.db-row-height - Theme.spacing-sm;
            border-radius: Theme.radius-sm;
            background: Colors.surface;
            border-width: 1px;
            border-color: Colors.border;

            TouchArea {
                width: parent.width;
                height: parent.height;
                mouse-cursor: MouseCursor.pointer;
                clicked => {
                    UIState.db-open-record(root.block.id, card.record);
                }
            }

            // the letter avatar: the title's first character, cut in Rust.
            // The *cover image* (a files column's first attachment) is D8's —
            // a thumbnail per realized card is the decode budget's business,
            // and the brief allows the letter as the stand-in.
            Rectangle {
                x: Theme.spacing-sm;
                y: 8px;
                width: 28px;
                height: 28px;
                border-radius: 14px;
                background: Colors.surface-hover;

                Text {
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    height: parent.height;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    text: card.letter;
                    font-family: Typography.ui-font;
                    font-size: Typography.size-ui;
                    font-weight: Typography.weight-semibold;
                    color: Colors.text-secondary;
                }
            }
            Text {
                x: Theme.spacing-sm;
                y: 42px;
                width: parent.width - 2 * Theme.spacing-sm;
                height: 20px;
                vertical-alignment: center;
                overflow: elide;
                text: card.title;
                font-family: Typography.ui-font;
                font-size: Typography.size-caption;
                font-weight: Typography.weight-medium;
                color: Colors.text-primary;
            }
            Text {
                x: Theme.spacing-sm;
                y: 64px;
                width: parent.width - 2 * Theme.spacing-sm;
                height: 16px;
                vertical-alignment: center;
                overflow: elide;
                text: card.cells.length > 0 ? card.cells[0].text : "";
                font-family: Typography.ui-font;
                font-size: Typography.size-caption;
                color: Colors.text-muted;
            }
        }
    }

    // ── a form (D5): the schema's fields, and one gesture that creates ────
    // The one layout that *reads no records to draw itself*: the fields are the
    // visible columns, the text is a draft held in the session, and nothing
    // reaches SQL until Submit — which parses every filled field through its
    // column's own rules and creates **one** record in **one** batch (one
    // Ctrl+Z). A form that half-created a record would be two facts about one
    // gesture, so a refused field refuses the whole submit and says which
    // column refused (the notice line).
    if root.live && root.is-form : Rectangle {
        x: 0px;
        y: root.body-top;
        width: root.content-width;
        height: root.body-h;
        background: transparent;

        for field[index] in root.block.db-form : Rectangle {
            x: 0px;
            y: index * 40px;
            width: root.grid-w;
            height: 40px;
            background: transparent;

            Text {
                x: 0px;
                y: 0px;
                width: root.grid-w / 4;
                height: parent.height;
                vertical-alignment: center;
                overflow: elide;
                text: field.name;
                font-family: Typography.ui-font;
                font-size: Typography.size-caption;
                color: Colors.text-secondary;
            }
            field-input := TextInput {
                x: root.grid-w / 4;
                y: 8px;
                width: root.grid-w * 3 / 4 - 8px;
                height: parent.height - 16px;
                vertical-alignment: center;
                // the draft's text; keystrokes go back into the session draft
                // and never into SQL, and Enter submits the whole form
                text: field.text;
                font-family: Typography.ui-font;
                font-size: Typography.size-caption;
                color: Colors.text-primary;
                edited => {
                    UIState.db-form-text(root.block.id, field.property, self.text);
                }
                accepted => {
                    UIState.db-form-text(root.block.id, field.property, self.text);
                    UIState.db-form-submitted(root.block.id);
                }
            }
        }

        // the action row: Submit (one record) and Clear (the draft)
        Rectangle {
            x: 0px;
            y: root.block.db-form.length * 40px;
            width: root.grid-w;
            height: 40px;
            background: transparent;

            submit-btn := Rectangle {
                x: root.grid-w / 4;
                y: 6px;
                width: 84px;
                height: 28px;
                border-radius: Theme.radius-sm;
                background: Colors.accent;

                Text {
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    height: parent.height;
                    text: "提交";
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    font-family: Typography.ui-font;
                    font-size: Typography.size-caption;
                    font-weight: Typography.weight-medium;
                    color: Colors.text-on-accent;
                }
                submit-ta := TouchArea {
                    width: parent.width;
                    height: parent.height;
                    mouse-cursor: MouseCursor.pointer;
                    clicked => {
                        UIState.db-form-submitted(root.block.id);
                    }
                }
            }
            clear-btn := Rectangle {
                x: root.grid-w / 4 + 92px;
                y: 6px;
                width: 64px;
                height: 28px;
                border-radius: Theme.radius-sm;
                background: clear-ta.has-hover ? Colors.surface-hover : transparent;

                Text {
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    height: parent.height;
                    text: "清空";
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    font-family: Typography.ui-font;
                    font-size: Typography.size-caption;
                    color: Colors.text-secondary;
                }
                clear-ta := TouchArea {
                    width: parent.width;
                    height: parent.height;
                    mouse-cursor: MouseCursor.pointer;
                    clicked => {
                        UIState.db-form-cleared(root.block.id);
                    }
                }
            }
        }
    }

    // ── a chart (D7): the group list, drawn as bar / line / pie ──────────
    // The one layout whose plot is **aggregates, not rows**: the points came
    // from one `GROUP BY` over an option-bounded column — the same query the
    // board's columns and the grouped table's headers run — so a 10 000-row
    // database's chart realizes zero rows and draws a handful of shapes. The
    // three shapes share the plot and the label strip; which one is drawn is
    // the view document's `chart` key, and the buttons above the plot are one
    // rule edit each (the same undo step a filter change is). The geometry
    // that needs trigonometry (the pie's arcs, the line's polyline) is built
    // in Rust in a fixed 100×100 viewbox, which these `Path`s scale — the
    // delegate places shapes and computes nothing but a fraction times a
    // height.
    if root.live && root.is-chart : Rectangle {
        x: 0px;
        y: root.body-top;
        width: root.content-width;
        height: Math.max(root.body-h, 0px);
        background: transparent;

        // the surface Rust reserved (CHART_HEIGHT): a 30px shape-button strip,
        // then the plot, then the 24px label strip
        property <length> chrome-h: 30px;
        property <length> label-h: 24px;
        property <length> plot-w: root.grid-w;
        property <length> plot-h: Math.max(
            parent.height - chrome-h - label-h, 0px);
        property <int> point-count: root.block.db-chart-points.length;

        // the three shapes, right-aligned over the plot: the active one is
        // tinted, and a click writes the view's `chart` key
        for shape[index] in ["柱状", "折线", "饼图"] : Rectangle {
            x: plot-w - (3 - index) * 52px;
            y: 5px;
            width: 48px;
            height: 20px;
            border-radius: Theme.radius-sm;
            background: root.block.db-chart-kind == index ? Colors.accent-soft
                : shape-ta.has-hover ? Colors.surface-hover : transparent;

            Text {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;
                horizontal-alignment: center;
                vertical-alignment: center;
                text: shape;
                font-family: Typography.ui-font;
                font-size: Typography.size-caption;
                color: root.block.db-chart-kind == index
                    ? Colors.accent-text : Colors.text-secondary;
            }
            shape-ta := TouchArea {
                width: parent.width;
                height: parent.height;
                mouse-cursor: MouseCursor.pointer;
                clicked => {
                    UIState.db-chart-kind(root.block.id, index);
                }
            }
        }

        // the plot
        Rectangle {
            x: 0px;
            y: chrome-h;
            width: plot-w;
            height: plot-h;
            background: transparent;

            // the baseline: every bar and the line read against it
            if point-count > 0 : Rectangle {
                x: 0px;
                y: parent.height - 1px;
                width: parent.width;
                height: 1px;
                background: Colors.border;
            }

            // ── bar: equal-width columns, each as tall as its fraction ────
            if point-count > 0 && root.block.db-chart-kind == 0 : HorizontalLayout {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;
                spacing: 12px;
                padding-left: 12px;
                padding-right: 12px;

                for pt in root.block.db-chart-points : Rectangle {
                    horizontal-stretch: 1;
                    background: transparent;
                    // a zero-count group is a 2px stub rather than nothing:
                    // the group exists, and its label below says whose it is
                    Rectangle {
                        y: parent.height - Math.max(parent.height * pt.frac, 2px);
                        width: parent.width;
                        height: Math.max(parent.height * pt.frac, 2px);
                        border-radius: 2px;
                        background: Colors.block-text(pt.slot);
                    }
                }
            }

            // ── line: one polyline through the fractions ──────────────────
            // The path arrived in a 100×100 viewbox (Rust built it), so the
            // `viewbox-*` pair below scales it to this plot; a single point
            // draws nothing (a move without a line), which is the honest
            // picture of one group.
            if point-count > 0 && root.block.db-chart-kind == 1 : Path {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;
                viewbox-width: 100;
                viewbox-height: 100;
                commands: root.block.db-chart-path;
                stroke: Colors.accent;
                stroke-width: 2px;
                stroke-line-cap: round;
                stroke-line-join: round;
                fill: transparent;
            }

            // ── pie: one filled path per slice, all in the same square ────
            if point-count > 0 && root.block.db-chart-kind == 2 : Rectangle {
                width: Math.max(Math.min(parent.width, parent.height) - 8px, 0px);
                height: self.width;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                background: transparent;

                for pt in root.block.db-chart-points : Path {
                    width: parent.width;
                    height: parent.height;
                    viewbox-width: 100;
                    viewbox-height: 100;
                    commands: pt.commands;
                    fill: Colors.block-text(pt.slot);
                    // a hairline of surface between slices, so two adjacent
                    // palette tints read as two slices
                    stroke: Colors.surface;
                    stroke-width: 1px;
                }
            }
        }

        // the label strip: one cell per point, "count · group" — the numbers
        // are Rust's (the `GROUP BY`'s), the words are the group's own label
        if point-count > 0 : HorizontalLayout {
            x: 0px;
            y: parent.height - label-h;
            width: root.grid-w;
            height: label-h;

            for pt in root.block.db-chart-points : Rectangle {
                horizontal-stretch: 1;
                background: transparent;
                Text {
                    x: 2px;
                    y: 0px;
                    width: parent.width - 4px;
                    height: parent.height;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                    overflow: elide;
                    text: pt.value + " · " + pt.label;
                    font-family: Typography.ui-font;
                    font-size: Typography.size-caption;
                    color: Colors.text-secondary;
                }
            }
        }

        // ── the two states a chart can be empty in ────────────────────────
        // A database with rows but no grouping column has *nothing to plot*
        // (the header's Group button is the door); a database with no rows
        // says so and offers its first row, like every other layout.
        if point-count == 0 && root.block.db-row-count > 0 : Text {
            x: 0px;
            y: chrome-h;
            width: parent.width;
            height: parent.height - chrome-h;
            vertical-alignment: center;
            horizontal-alignment: center;
            text: "选择一个要分组的列";
            font-family: Typography.ui-font;
            font-size: Typography.size-caption;
            color: Colors.text-muted;
        }
        if point-count == 0 && root.block.db-row-count == 0 : Rectangle {
            x: 0px;
            y: chrome-h;
            width: parent.width;
            height: 34px;
            background: chart-empty-ta.has-hover ? Colors.surface-hover : transparent;

            Text {
                x: Theme.spacing-sm;
                y: 0px;
                height: parent.height;
                vertical-alignment: center;
                text: "还没有行 - 新建行即可添加";
                font-family: Typography.ui-font;
                font-size: Typography.size-caption;
                color: Colors.text-muted;
            }
            chart-empty-ta := TouchArea {
                width: parent.width;
                height: parent.height;
                mouse-cursor: MouseCursor.pointer;
                clicked => {
                    UIState.db-row-added(root.block.id);
                }
            }
        }
    }

    // ── a layout this build cannot draw yet (D7) ─────────────────────────
    // SPEC §三十九's order is the implementation order, so a database written by
    // a later build can name a view this one has no drawing for. It says which
    // view it is, instead of showing a table that is not what was asked for.
    if root.foreign : Rectangle {
        x: 0px;
        y: root.body-top;
        width: root.content-width;
        height: root.empty-h;
        background: transparent;

        Text {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            vertical-alignment: center;
            text: "\{root.block.db-layout} 视图 - 此版本尚未支持";
            font-family: Typography.ui-font;
            font-size: Typography.size-caption;
            color: Colors.text-muted;
        }
    }
}

