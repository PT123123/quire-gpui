// A rendered block. Deliberately NOT a TextEdit per block (ADR-0003):
// static blocks are Text + shapes. The ONE focused block swaps to a live
// TextInput (edit-input, visible-gated so the row height can track it);
// structural keys are routed to the Rust command layer.

import { Theme } from "../Theme.slint";
import { Colors } from "../Colors.slint";
import { Typography, PageType } from "../Typography.slint";
import { Icon } from "../Icons.slint";
import { BlockHandle } from "./BlockHandle.slint";
import { TableBlock } from "./TableBlock.slint";
import { ColumnsBlock } from "./ColumnsBlock.slint";
import { DatabaseView } from "./DatabaseView.slint";
import { BlockRow, UIState } from "../Types.slint";

export component EditorBlock inherits Rectangle {
    in property <BlockRow> block;
    in property <int> depth;
    in property <int> index;
    in property <length> row-y; // body top in list-layout coords (scroll handled in Rust)
    in property <length> content-width;
    in property <length> content-x;

    property <bool> is-list: block.kind == 4 || block.kind == 5 || block.kind == 6;
    property <length> list-indent: (is-list ? root.depth * 24px : 0px);
    property <bool> is-heading: block.kind == 1 || block.kind == 2 || block.kind == 3;
    property <bool> is-plain: block.kind <= 6 || block.kind == 13 || block.kind == 24;
    property <bool> is-page: block.kind == 11;
    property <bool> is-link: block.kind == 12;
    property <bool> is-page-ish: is-page || is-link;
    property <bool> is-image: block.kind == 14;
    property <bool> is-file: block.kind == 15;
    property <bool> is-table: block.kind == 16;
    property <bool> is-columns: block.kind == 18;
    property <bool> is-math: block.kind == 20;
    property <bool> is-toc: block.kind == 21;
    property <bool> is-embed: block.kind == 22;
    // database (kind 23, SPEC §三十九): a leaf like a grid or a layout — it owns
    // no child blocks (its rows are records, its cells are values)
    property <bool> is-database: block.kind == 23;
    // The row's height is the view's own (SPEC §三十九 红线第一条): the header
    // plus the layout's surface, both computed in Rust (`db-header-height`,
    // `db-body-height` — the layout's own shape since D5: a table's rows, a
    // board's tallest column, a gallery's card rows, the calendar's fixed grid,
    // the form's fields). One source, so the delegate and the window arithmetic
    // cannot disagree about a row's height. An empty database reserves one
    // clickable line (the calendar and the form always draw their own bodies);
    // a dangling entity is its one muted line (ADR-0060).
    property <length> db-height: !block.db-ok ? 34px
        : block.db-header-height
            + Math.max(block.db-body-height, 34px);
    // synced block (kind 24), SPEC §四十 / ADR-0052: a second view of one other
    // block. Draws like a plain line because a plain line is what it is — the
    // only thing that differs is *whose* words sit in it.
    property <bool> is-synced: block.kind == 24;
    // **Whose words the caret is in.** For a mirror this is the source block,
    // not the row itself, because the row owns nothing — and that one
    // substitution is the whole of "edit either copy and both change": there is
    // still exactly one block being written to. `sync-source == -1` (nothing
    // resolved) leaves this comparing against an id no block can have, so an
    // unresolvable mirror simply cannot enter edit mode. Where those keystrokes
    // would go is a question the row cannot answer, and putting them somewhere
    // anyway is worse than refusing.
    property <int> content-id: root.is-synced ? block.sync-source : block.id;
    // the row keeps room for its own glyph in the same way a toggle keeps room
    // for its chevron: the sentence in the column belongs to another block,
    // while the glyph is the only part of this row that is its own.
    property <length> sync-gutter: root.is-synced ? 22px : 0px;
    // picture (kind 14): the row's height comes from the raster's ratio, which
    // Rust knows from the attachments row. 0 means there is no picture to
    // show — a missing file or an attachment from another library — and the
    // row falls back to naming it.
    property <float> pic-aspect: is-image ? UIState.image-aspect(block.attachment) : 0;
    property <length> pic-width: content-width
        * (block.img-percent > 0 ? block.img-percent : 100) / 100;
    property <length> pic-height: root.pic-width * pic-aspect;
    // file (kind 15): one line of label in a fixed box. The size is a lookup
    // because it lives in the attachments row, not in the block.
    property <length> file-height: PageType.size-body * PageType.line-body
        + 2 * Theme.spacing-md;
    property <string> file-size: is-file ? UIState.attachment-size(block.attachment) : "";
    // embed (kind 22): two lines of derived text in one box — the provider the
    // address belongs to, and the address the Open button will hand over. Both
    // are functions of the block's own text, so the card cannot disagree with
    // what was typed into it.
    property <length> embed-height: PageType.size-body * PageType.line-body
        + Typography.size-caption * PageType.line-body + 2 * Theme.spacing-md;
    property <length> embed-inset: Theme.spacing-md + 19px + Theme.spacing-sm;
    // A locked page has no live input, wherever its caret came from: binding
    // the switch here means `editing-id` cannot survive an unlock/relock cycle
    // into a row that would otherwise still be typing (SPEC §三十八).
    //
    // `root.content-id` rather than `block.id` because a mirror's row shows
    // another block's words: "am I being edited" is a question about the
    // content this row is showing, not about the row itself (SPEC §四十).
    property <bool> editing: UIState.editing-id == root.content-id
        && !UIState.page-locked
        && block.kind != 9 && block.kind != 11 && block.kind != 12
        && block.kind != 14 && block.kind != 15 && block.kind != 16
        && block.kind != 18 && !is-toc && !is-database;

    // toggle (kind 13) keeps a gutter for its chevron even when the block
    // has no children yet, so the text does not jump as the section grows
    property <length> fold-gutter: block.kind == 13 ? 22px : 0px;

    // block color pair (⋮⋮ Text color / Background color; ADR-0023)
    property <color> block-text-color: Colors.block-text(block.color);
    property <color> block-bg-color: Colors.block-bg(block.bg);

    // font metrics shared by the static Text and the live input
    property <length> body-font-size: block.kind == 1 ? PageType.size-h1
        : block.kind == 2 ? PageType.size-h2
        : block.kind == 3 ? PageType.size-h3
        : block.kind == 8 ? PageType.size-code
        : PageType.size-body;
    property <float> body-line-factor: block.kind == 1 ? PageType.line-h1
        : block.kind == 2 ? PageType.line-h2
        : block.kind == 3 ? PageType.line-h3
        : block.kind == 8 ? PageType.line-code
        : PageType.line-body;

    property <length> top-margin:
        block.kind == 1 ? Theme.spacing-xl
        : block.kind == 2 ? Theme.spacing-lg + Theme.spacing-xs
        : block.kind == 3 || block.kind == 9 || block.kind == 10
            || block.kind == 14 || block.kind == 15 || block.kind == 16
            || block.kind == 18 || block.kind == 20 || block.kind == 21
            || block.kind == 22 || block.kind == 23
            ? Theme.spacing-md
        : 0px;

    property <length> input-x: content-x
        + (is-list ? 26px : 0px)
        + root.fold-gutter
        + (block.kind == 7 ? Theme.spacing-md : 0px)
        + (block.kind == 10 ? 40px : 0px)
        + (block.kind == 22 ? root.embed-inset : 0px);
    property <length> input-width: content-width
        - (is-list ? 26px : 0px)
        - root.fold-gutter
        - (block.kind == 7 ? Theme.spacing-md : 0px)
        - (block.kind == 10 ? 40px : 0px)
        - (block.kind == 8 ? 2 * Theme.spacing-md : 0px)
        - (block.kind == 22 ? root.embed-inset + 34px + Theme.spacing-sm : 0px);

    // Text with an explicit width + wrap sizes itself (height-for-width);
    // while editing, the live input's height takes over.
    property <length> body-height:
        editing ? (block.kind == 8
                ? edit-input.height + 2 * Theme.spacing-md
                : block.kind == 10
                ? edit-input.height + 2 * Theme.spacing-sm
                : block.kind == 22
                // the card keeps its two-line box while the address is being
                // typed, so clicking it to edit does not move the page below
                ? Math.max(root.embed-height, edit-input.height + 2 * Theme.spacing-md)
                : edit-input.height + (block.kind == 7 ? Theme.spacing-xs : 0px))
        : block.kind == 7 ? quote-text.height + Theme.spacing-xs
        : block.kind == 8 ? code-text.height + 2 * Theme.spacing-md
        : block.kind == 10 ? callout-text.height + 2 * Theme.spacing-sm
        : block.kind == 20 ? math-text.height + 2 * Theme.spacing-sm
        : block.kind == 21 ? toc-list.preferred-height + 2 * Theme.spacing-sm
        : block.kind == 22 ? root.embed-height
        : block.kind == 9 ? 20px
        : block.kind == 14 ? (pic-aspect > 0 ? pic-height : missing-text.height)
        : block.kind == 15 ? root.file-height
        : block.kind == 16 ? tbl.height
        : block.kind == 18 ? clm.height
        : is-database ? root.db-height
        : is-page-ish ? page-text.height
        : plain-text.height;

    height: top-margin + body-height + (block.kind == 0 ? Theme.spacing-xs : Theme.spacing-sm);

    ta := TouchArea {
        width: parent.width;
        height: parent.height;
        // stays enabled while editing so hover (and the handle) keep working;
        // only the click is suppressed — the live input sits on top for text
        // a contents line is a target, not a place to type
        mouse-cursor: is-page-ish || is-image || is-toc ? MouseCursor.pointer : MouseCursor.text;
        clicked => {
            // one TouchArea for the row: a second one over the picture would
            // have taken the hover the block handle depends on
            if (is-image) {
                UIState.preview-attachment = block.attachment;
            }
            // a table owns its clicks: each cell is the thing you aim at, and
            // activating the table itself would put a caret in nowhere. Same
            // for a layout: its boxes are where the text is. And same for a
            // database: its cells are the aim points too (SPEC §三十九).
            else if (!is-table && !is-columns && !is-database && !editing) {
                UIState.block-activate(block.id);
            }
        }
    }

    Rectangle {
        x: content-x - 8px;
        width: content-width + 16px;
        y: top-margin;
        height: body-height;
        border-radius: Theme.radius-sm;
        // a colored block keeps its tint; hover only paints on uncolored rows
        background: block.bg > 0 ? block-bg-color
            : ta.has-hover && !editing ? Colors.hover-fill
            : editing ? Colors.hover-fill
            : transparent;
        animate background { duration: Theme.duration-instant; }
    }

    handle := BlockHandle {
        x: root.content-x - 48px;
        y: top-margin;
        block-id: block.id;
        // hover on the row OR on the buttons themselves — never gated on
        // !editing: opacity 0 does not stop hit-testing, so an editing-row
        // handle hidden by that clause stayed clickable in the dark. The grid
        // adds its own hover: a cell's TouchArea takes the row's, and the
        // handle would disappear the moment the pointer reached the table.
        visible-flag: ta.has-hover || handle.hovered || tbl.inner-hover
            || clm.inner-hover;
        plus-clicked => {
            // anchor the insert menu below this block: bottom edge in list
            // coords + the text column x
            UIState.block-plus(block.id, root.row-y + root.height, root.content-x);
        }
        grip-clicked => {
            if UIState.block-menu-open-id == block.id {
                UIState.block-menu-open-id = -1;
            } else {
                UIState.block-menu-opened(block.id, root.row-y + handle.y, root.content-x);
            }
        }
    }

    // drag-reorder target: fills the row, accepts only our own block payload.
    // Normal clicks pass straight through (DropArea ignores non-drag events).
    DropArea {
        can-drop(event) => {
            let below: bool = event.position.y * 2 > self.height;
            if (UIState.block-drag-hover(event.data, root.index, below)) {
                UIState.drop-line-row = root.index + (below ? 1 : 0);
                DragAction.move
            } else {
                UIState.drop-line-row = -1;
                DragAction.none
            }
        }
        dropped(event) => {
            let below: bool = event.position.y * 2 > self.height;
            UIState.block-dropped(event.data, root.index, below);
            DragAction.move
        }
    }

    // callout (kind 10): a tinted box with an emoji beside the text; the
    // background colour picker overrides the default tint. The box and the
    // emoji are declared here, above the runs, because Slint paints later
    // siblings on top -- a box declared after them would cover every find
    // cell the callout holds (ADR-0043).
    Rectangle {
        x: content-x;
        y: top-margin;
        width: content-width;
        height: root.body-height;
        visible: block.kind == 10;
        border-radius: Theme.radius-md;
        background: block.bg > 0 ? block-bg-color : Colors.callout-background;
    }
    Text {
        x: content-x + Theme.spacing-sm;
        y: top-margin + Theme.spacing-sm + 2px;
        width: 26px;
        visible: block.kind == 10;
        text: "💡";
        font-size: PageType.size-body;
        vertical-alignment: center;
    }

    // A quote and a callout hold one line of body text like a paragraph does,
    // and their delegate is a single Text — so a find hit inside one has
    // nowhere to sit until the runs path covers them too (ADR-0043). They
    // share the flexbox and bring only their own frame.
    property <bool> is-quote: block.kind == 7;
    property <bool> is-callout: block.kind == 10;
    property <bool> runs-line: is-plain || root.is-quote || root.is-callout;
    property <length> runs-x: root.is-quote ? content-x + Theme.spacing-md
        : root.is-callout ? content-x + 40px
        : content-x + list-indent + (is-list ? 26px : 0px) + root.fold-gutter
        + root.sync-gutter;
    property <length> runs-y: root.is-callout ? top-margin + Theme.spacing-sm : top-margin;
    property <length> runs-width: root.is-quote ? content-width - Theme.spacing-md
        : root.is-callout ? content-width - 40px - Theme.spacing-sm
        : content-width - list-indent - (is-list ? 26px : 0px) - root.fold-gutter
        - root.sync-gutter;
    property <length> runs-height: root.is-quote ? quote-text.height
        : root.is-callout ? callout-text.height : plain-text.height;

    // inline-mark runs (M6). Slint Text has no inline formatting, so a
    // marked block renders as runs laid side by side by a wrapping flexbox:
    // each run is one cell and a line breaks between cells. Rust cuts the
    // unmarked stretches to a word per run, which is where the breaks come
    // from (ADR-0041). Unmarked blocks keep the wrapping Text.
    if runs-line && !editing && block.runs.length > 0 : Rectangle {
        x: runs-x;
        width: runs-width;
        y: runs-y;
        height: runs-height;
        clip: true;
        FlexboxLayout {
            flex-wrap: wrap;
            // start, not the default stretch: a short marked line leaves
            // space in the frame, and a stretching layout spends it as gaps
            // between the runs instead of leaving it at the end
            alignment: start;
            spacing: 0px;
            for run in block.runs : Rectangle {
                // SPEC §四十: a mention and a date are the two *particles* —
                // atoms the line cannot break and that carry a surface of
                // their own. Their glyph and padding are what the cell's floor
                // has to include, so they are named here instead of being
                // written out again in `min-width` and in the text's x.
                property <bool> particle: run.mention >= 0 || run.date;
                property <length> particle-glyph: particle ? 12px : 0px;
                property <length> particle-pad: particle ? 4px : 0px;
                // natural run size: decorations anchor to the text line
                // (Slint Text has no font-style — italic via family name).
                // min-width (instead of width — Slint rejects both) pins the
                // layout: a long paragraph's natural run widths overflow the
                // container, and without the floor the layout compressed the
                // runs into each other (A4 sweep D1's overprint)
                min-width: run-text.preferred-width + particle-glyph + (particle ? 6px : 0px);
                height: run-text.preferred-height;
                vertical-stretch: 0;
                horizontal-stretch: 0;
                // a link and a live mention both go somewhere; a chip whose
                // page is gone has nothing to open, so it is not a target
                property <bool> follows: run.link || (run.mention >= 0 && !run.mention-deleted);
                if follows : TouchArea {
                    mouse-cursor: MouseCursor.pointer;
                    clicked => {
                        UIState.open-link(run.url);
                    }
                }
                // paint order matters: the code background must be declared
                // BEFORE the text or it covers the glyphs
                if run.code : Rectangle {
                    border-radius: Theme.radius-xs;
                    background: Colors.code-background;
                    border-width: 1px;
                    border-color: Colors.border;
                }
                // A find hit is a cell of its own (ADR-0041 cuts the line at
                // the hit's byte bounds and never word-splits inside one), so
                // this box is one occurrence. Its fill only says "this cell" --
                // the border is what the eye reads, because a fill that is a
                // 3:1 marker by itself takes every coloured text pair below it
                // (Colors.find-hit). It comes after the code box on purpose:
                // the two are the same geometry, and a search that lands on an
                // inline code span has to show the match, not the span.
                if run.hit : Rectangle {
                    border-radius: Theme.radius-xs;
                    background: Colors.find-hit;
                    border-width: 1px;
                    border-color: Colors.find-hit-border;
                }
                // the chip's own surface, and again after the hit: a search
                // that lands on a mention must still show the match, so the
                // hit fill is the one that stays on top
                if particle : Rectangle {
                    border-radius: Theme.radius-xs;
                    // gone = the target page was deleted: the atom keeps its
                    // shape and loses its colour, which is the same "still
                    // readable, clearly broken" state a dangling Page block
                    // shows (ADR-0026 / ADR-0029)
                    background: run.mention-deleted ? Colors.code-background
                        : (run.date ? Colors.code-background : Colors.accent-soft);
                }
                if particle : Icon {
                    x: particle-pad;
                    y: (parent.height - particle-glyph) / 2;
                    name: run.date ? "clock" : "page";
                    size: particle-glyph;
                    color: run.mention-deleted ? Colors.text-muted
                        : (run.date ? Colors.text-muted : Colors.accent-text);
                }
                run-text := Text {
                    x: particle ? particle-pad + particle-glyph + 2px : 0px;
                    y: 0;
                    wrap: no-wrap;
                    text: run.text;
                    font-family: run.code ? Typography.mono-font
                        : run.italic ? PageType.italic-font-family : PageType.font-family;
                    font-size: run.code ? PageType.size-code : body-font-size;
                    font-weight: run.bold ? Typography.weight-bold
                        : (is-heading ? Typography.weight-semibold : Typography.weight-regular);
                    color: run.link ? Colors.accent-text
                        : run.mention-deleted ? Colors.text-muted
                        : run.date ? Colors.text-secondary
                        : run.mention >= 0 ? Colors.accent-text
                        : block-text-color;
                    line-height-factor: body-line-factor;
                }
                if run.strike : Rectangle {
                    y: (parent.height - 1.2px) / 2;
                    width: parent.width;
                    height: 1.2px;
                    background: Colors.text-secondary;
                }
                if run.link : Rectangle {
                    y: parent.height - 2px;
                    width: parent.width;
                    height: 1px;
                    background: Colors.accent-text;
                }
            }
        }
    }

    plain-text := Text {
        x: runs-x;
        width: runs-width;
        y: top-margin;
        visible: is-plain && !editing && block.runs.length == 0;
        text: block.text;
        font-family: PageType.font-family;
        font-size: body-font-size;
        font-weight: is-heading ? Typography.weight-semibold : Typography.weight-regular;
        color: block.checked && block.kind == 6 ? Colors.text-muted : block-text-color;
        line-height-factor: body-line-factor;
        wrap: word-wrap;
    }

    // ---- live editor for the focused block ----
    edit-input := TextInput {
        visible: editing;
        enabled: editing;
        x: input-x + list-indent;
        width: input-width - list-indent;
        // explicit preferred height: an implicit height would derive from
        // the row, which derives its height from this input (loop)
        height: self.preferred-height;
        y: top-margin + (block.kind == 8 ? Theme.spacing-md : 0px)
            + (block.kind == 10 ? Theme.spacing-sm : 0px)
            + (block.kind == 22 ? Theme.spacing-md : 0px);
        font-family: block.kind == 8 ? Typography.mono-font : PageType.font-family;
        font-size: body-font-size;
        font-weight: is-heading ? Typography.weight-semibold : Typography.weight-regular;
        color: block.checked && block.kind == 6 ? Colors.text-muted : block-text-color;
        line-height-factor: body-line-factor;
        wrap: word-wrap;
        single-line: block.kind != 8;
        text <=> UIState.editing-text;
        selection-foreground-color: Colors.text-primary;
        selection-background-color: Colors.selection;
        edited => {
            UIState.editing-changed(root.row-y + self.y, self.height, content-x);
        }
        accepted => {
            UIState.enter-at-caret(self.cursor-position-byte-offset);
        }
        key-pressed(event) => {
            if (UIState.slash-open && event.text == Key.UpArrow) {
                UIState.slash-move(-1);
                accept
            } else if (UIState.slash-open && event.text == Key.DownArrow) {
                UIState.slash-move(1);
                accept
            } else if (UIState.slash-open && event.text == Key.Return) {
                UIState.slash-apply-selected();
                accept
            } else if (UIState.slash-open && event.text == Key.Escape) {
                UIState.slash-close();
                accept
            } else if (UIState.slash-open && event.text == " ") {
                UIState.slash-close();
                reject
            } else if (event.modifiers.control && event.text == Key.B
                && self.anchor-position-byte-offset != self.cursor-position-byte-offset) {
                UIState.toggle-mark(0, self.anchor-position-byte-offset, self.cursor-position-byte-offset);
                accept
            } else if (event.modifiers.control && event.text == Key.I
                && self.anchor-position-byte-offset != self.cursor-position-byte-offset) {
                UIState.toggle-mark(1, self.anchor-position-byte-offset, self.cursor-position-byte-offset);
                accept
            } else if (event.modifiers.control && event.modifiers.shift && event.text == Key.X
                && self.anchor-position-byte-offset != self.cursor-position-byte-offset) {
                UIState.toggle-mark(2, self.anchor-position-byte-offset, self.cursor-position-byte-offset);
                accept
            } else if (event.modifiers.control && event.text == Key.E
                && self.anchor-position-byte-offset != self.cursor-position-byte-offset) {
                UIState.toggle-mark(3, self.anchor-position-byte-offset, self.cursor-position-byte-offset);
                accept
            } else if (event.modifiers.control && event.text == Key.M
                && self.anchor-position-byte-offset != self.cursor-position-byte-offset) {
                UIState.toggle-mark(4, self.anchor-position-byte-offset, self.cursor-position-byte-offset);
                accept
            } else if (event.text == Key.Tab
                && !event.modifiers.shift
                && (block.kind == 4 || block.kind == 5 || block.kind == 6)) {
                UIState.indent-list(block.id);
                accept
            } else if (event.text == Key.Tab
                && event.modifiers.shift
                && (block.kind == 4 || block.kind == 5 || block.kind == 6)) {
                UIState.outdent-list(block.id);
                accept
            } else if (event.modifiers.control && event.text == Key.D) {
                UIState.duplicate-block(block.id);
                accept
            } else if (event.modifiers.control && event.text == Key.L
                && self.anchor-position-byte-offset != self.cursor-position-byte-offset) {
                UIState.link-start = Math.min(self.anchor-position-byte-offset, self.cursor-position-byte-offset);
                UIState.link-end = Math.max(self.anchor-position-byte-offset, self.cursor-position-byte-offset);
                UIState.link-url = "";
                UIState.link-open = true;
                accept
            } else if (event.text == Key.Tab
                && !event.modifiers.shift
                && (block.kind == 4 || block.kind == 5 || block.kind == 6)) {
                UIState.indent-list(block.id);
                accept
            } else if (event.text == Key.Tab
                && event.modifiers.shift
                && (block.kind == 4 || block.kind == 5 || block.kind == 6)) {
                UIState.outdent-list(block.id);
                accept
            } else if (event.modifiers.control && event.text == Key.D) {
                UIState.duplicate-block(block.id);
                accept
            } else if (event.modifiers.control && event.text == Key.L
                && self.anchor-position-byte-offset != self.cursor-position-byte-offset) {
                UIState.link-start = Math.min(self.anchor-position-byte-offset, self.cursor-position-byte-offset);
                UIState.link-end = Math.max(self.anchor-position-byte-offset, self.cursor-position-byte-offset);
                UIState.link-url = "";
                UIState.link-open = true;
                accept
            } else if (event.modifiers.control && event.text == Key.V) {
                // rich paste first (clipboard markdown → blocks); a false
                // return falls through to the native plain paste
                if (UIState.rich-paste(block.id)) {
                    accept
                } else {
                    reject
                }
            } else if (event.text == Key.Backspace
                && self.cursor-position-byte-offset == 0
                && self.anchor-position-byte-offset == 0) {
                UIState.backspace-at-start();
                accept
            } else if (event.modifiers.control && event.text == Key.Z && event.modifiers.shift) {
                UIState.redo-requested();
                accept
            } else if (event.modifiers.control && event.text == Key.Z) {
                UIState.undo-requested();
                accept
            } else if (event.modifiers.control && event.text == Key.Y) {
                UIState.redo-requested();
                accept
            } else if (block.kind != 8 && event.text == Key.UpArrow) {
                UIState.focus-move(-1);
                accept
            } else if (block.kind != 8 && event.text == Key.DownArrow) {
                UIState.focus-move(1);
                accept
            } else if (event.modifiers.control && event.modifiers.shift
                && event.text == Key.UpArrow) {
                UIState.move-block(-1);
                accept
            } else if (event.modifiers.control && event.modifiers.shift
                && event.text == Key.DownArrow) {
                UIState.move-block(1);
                accept
            } else if (event.text == Key.Escape) {
                UIState.cancel-editing();
                accept
            } else {
                reject
            }
        }
        init => {
            edit-input.focus();
            if (UIState.pending-caret >= 0) {
                edit-input.set-selection-offsets(UIState.pending-caret, UIState.pending-caret);
                UIState.pending-caret = -1;
            }
        }
    }

    Rectangle {
        x: content-x + list-indent + 8px;
        y: top-margin + PageType.size-body * PageType.line-body / 2 - 5px;
        width: 6px;
        height: 6px;
        border-radius: 3px;
        visible: block.kind == 4;
        background: block-text-color;
    }

    Text {
        x: content-x + list-indent + 2px;
        y: top-margin;
        width: 22px;
        visible: block.kind == 5;
        text: "\{block.number}.";
        font-family: PageType.font-family;
        font-size: PageType.size-body;
        color: block-text-color;
        line-height-factor: PageType.line-body;
    }

    Rectangle {
        x: content-x + list-indent + 2px;
        y: top-margin + PageType.size-body * PageType.line-body / 2 - 8px;
        width: 17px;
        height: 17px;
        visible: block.kind == 6;
        border-radius: Theme.radius-xs;
        border-width: block.checked ? 0px : 1.5px;
        border-color: Colors.border-strong;
        background: block.checked ? Colors.accent : transparent;
        animate background { duration: Theme.duration-fast; }
        Icon {
            x: 1.5px; y: 1.5px;
            name: "todo-check";
            size: 14px;
            stroke-width: 2.4px;
            color: Colors.text-on-accent;
            visible: block.checked;
        }
        TouchArea {
            mouse-cursor: MouseCursor.pointer;
            clicked => {
                UIState.todo-toggled(block.id);
            }
        }
    }

    // toggle (kind 13): the chevron is the whole affordance — the text stays
    // an ordinary editable line. `can-fold` (Rust: the block has children)
    // keeps the triangle off a section that has nothing to hide.
    Rectangle {
        x: content-x + list-indent;
        y: top-margin + PageType.size-body * PageType.line-body / 2 - 9px;
        width: 18px;
        height: 18px;
        border-radius: Theme.radius-xs;
        visible: block.kind == 13 && block.can-fold;
        background: fold-ta.has-hover ? Colors.hover-fill : transparent;
        animate background { duration: Theme.duration-instant; }
        Icon {
            x: 1px; y: 1px;
            name: block.folded ? "chevron-right" : "chevron-down";
            size: 16px;
            stroke-width: 1.8px;
            color: Colors.text-secondary;
        }
        fold-ta := TouchArea {
            mouse-cursor: MouseCursor.pointer;
            clicked => {
                UIState.toggle-fold(block.id);
            }
        }
    }

    Rectangle {
        x: content-x;
        y: top-margin + 2px;
        width: 3px;
        height: quote-text.height - 2px;
        visible: block.kind == 7 && !editing;
        border-radius: 2px;
        background: block-text-color;
    }
    quote-text := Text {
        x: runs-x;
        y: top-margin;
        width: runs-width;
        visible: block.kind == 7 && !editing && block.runs.length == 0;
        text: block.text;
        font-family: PageType.font-family;
        font-size: PageType.size-body;
        color: block-text-color;
        line-height-factor: PageType.line-body;
        wrap: word-wrap;
    }

    // code (kind 8) highlight (SPEC §三十七 批次 C).
    //
    // The frame the block's text lives in, which is also the live input's frame
    // for this kind: the two have to break lines in the same places, so the row
    // cannot reflow under the caret.
    property <length> code-width: input-width;
    // A language is what makes a block coloured: an unstored one is plain text
    // and gets none of the layers below.
    property <bool> is-highlighted: block.kind == 8 && block.lang != "";
    // One character of the mono font, measured once for the app by Editor.slint.
    // Its quotient with `code-width` is the column budget the lexer wraps to;
    // 0 before that first measurement means "add no breaks", which is the safe
    // answer — Slint still wraps the text, and every layer shares that.
    property <length> char-advance: UIState.code-advance;

    Rectangle {
        x: content-x;
        y: top-margin;
        width: content-width;
        height: root.body-height;
        visible: block.kind == 8;
        border-radius: Theme.radius-md;
        background: block.bg > 0 ? block-bg-color : Colors.code-background;
        border-width: 1px;
        border-color: Colors.border;
    }
    code-text := Text {
        x: content-x + Theme.spacing-md;
        y: top-margin + Theme.spacing-md;
        width: root.code-width;
        visible: block.kind == 8 && !editing;
        // The block's own colour is one layer of the highlight like any other,
        // and it is the layer the row measures itself with — the height a code
        // block costs comes from the same string the colours are stacked on, so
        // no second layout has to agree with the first. Unguided, the `: ""`
        // branch keeps every other row of the page from running the lexer.
        text: block.kind == 8 && block.lang != ""
            ? UIState.code-layer(block.text, block.lang, root.code-width, root.char-advance, 0)
            : block.text;
        font-family: Typography.mono-font;
        font-size: PageType.size-code;
        color: block-text-color;
        line-height-factor: PageType.line-code;
        wrap: word-wrap;
    }

    // code highlight (SPEC §三十七 批次 C). Slint Text paints one colour, so a
    // coloured block is five `Text`s of the same text stacked on each other, and
    // what makes them line up is that each is the whole block with everything of
    // a different colour blanked (core::highlight). They are the same length and
    // break at the same hard newlines, so the layer that measures the row above
    // is also one of them, and nothing here depends on a layout engine agreeing
    // with another.
    //
    // A conditional element, not a `visible:` flag: `visible` does not stop a
    // binding from running, so five lexer calls would fire on every repaint of
    // every row of the page to paint a rectangle nobody sees.
    if root.is-highlighted && !editing : Rectangle {
        x: code-text.x;
        y: code-text.y;
        width: root.code-width;
        height: code-text.height;
        // The model assumes a monospace font, and this is the floor under that
        // assumption: if the theme's font is not quite one, a layer ends up
        // taller than the measure and the row keeps the measure's height.
        clip: true;
        // Drawn in the order 1, 3, 4, 5 and then 2, so the comment colour is on
        // top: a character no layer may blank (anything that is not ASCII, whose
        // width this model cannot know) is copied into all of them, and prose is
        // what is most likely to be one.
        for kl in 5 : Text {
            property <int> kind: kl == 0
                ? 1
                : kl == 1
                ? 3
                : kl == 2
                ? 4
                : kl == 3
                ? 5
                : 2;
            // The same width the measuring layer has, not the element's natural
            // one: a `Text` with no width never wraps, so a layer would break
            // only at the lexer's hard newlines while the row above it breaks
            // wherever Slint's own wrap does too — and the two would drift a
            // line apart, which is what the first shot of this scene showed.
            width: root.code-width;
            text: UIState.code-layer(
                block.text, block.lang, root.code-width, root.char-advance, self.kind);
            font-family: Typography.mono-font;
            font-size: PageType.size-code;
            color: Colors.code-token(self.kind);
            line-height-factor: PageType.line-code;
            wrap: word-wrap;
        }
    }

    // math (kind 20): the formula, centred in a box like a code block's. What
    // the box shows is derived — `math-render` turns the stored LaTeX subset
    // into Unicode — and what the live input shows is the source, because the
    // user edits the formula, never its picture. An empty block says "$$" so
    // the slot has a height and reads as a formula rather than a blank band.
    Rectangle {
        x: content-x;
        y: top-margin;
        width: content-width;
        height: root.body-height;
        visible: is-math;
        border-radius: Theme.radius-md;
        background: block.bg > 0 ? block-bg-color : Colors.code-background;
        border-width: 1px;
        border-color: Colors.border;
    }
    math-text := Text {
        x: content-x;
        y: top-margin + Theme.spacing-sm;
        width: content-width;
        visible: is-math && !editing;
        // the `: ""` branch matters: a binding is per element, not per kind,
        // and an invisible Text still evaluates it — so without the guard
        // every row of a page would run the renderer
        text: is-math ? UIState.math-render(block.text == "" ? "$$" : block.text) : "";
        horizontal-alignment: center;
        font-family: PageType.font-family;
        font-size: PageType.size-body;
        color: block-text-color;
        line-height-factor: PageType.line-body;
        wrap: word-wrap;
    }

    // toc (kind 21): the page's own contents. The block stores nothing here —
    // `toc-entries` is this page's headings, re-read by the projection, so
    // renaming a heading renames its line and no copy can go stale. Clicking a
    // line walks the same path a `quire://block/` link walks.
    Rectangle {
        x: content-x;
        y: top-margin;
        width: content-width;
        height: root.body-height;
        visible: is-toc;
        border-radius: Theme.radius-md;
        border-width: 1px;
        border-color: Colors.border;
        background: block.bg > 0 ? block-bg-color : Colors.code-background;
    }
    toc-list := VerticalLayout {
        x: content-x + Theme.spacing-md;
        y: top-margin + Theme.spacing-sm;
        width: content-width - 2 * Theme.spacing-md;
        visible: is-toc;
        // start, not the layout's default stretch: the entries want their own
        // height and the leftover goes below the list, not between the lines
        alignment: start;
        spacing: 2px;

        Text {
            text: "目录";
            font-family: Typography.ui-font;
            font-size: Typography.size-caption;
            font-weight: Typography.weight-semibold;
            color: Colors.text-muted;
        }
        for entry in block.toc-entries : Rectangle {
            // one line tall by the font's own metrics, and elided: a heading
            // that does not fit is a long heading, not a second line — the
            // row's height cannot come from the Text inside it, either, because
            // a child of a Rectangle is 100 % of it by default
            height: PageType.size-body * PageType.line-body + 4px;
            toc-entry-touch := TouchArea {
                clicked => {
                    UIState.toc-jump(entry.block);
                }
            }
            Rectangle {
                border-radius: Theme.radius-xs;
                background: toc-entry-touch.has-hover ? Colors.hover-fill : transparent;
            }
            Text {
                x: (entry.level - 1) * 16px;
                width: parent.width - self.x;
                text: entry.label;
                font-family: PageType.font-family;
                font-size: PageType.size-body;
                color: Colors.text-primary;
                vertical-alignment: center;
                overflow: elide;
            }
        }
        if block.toc-entries.length == 0 : Text {
            text: "此页面还没有标题";
            font-family: PageType.font-family;
            font-size: PageType.size-body;
            color: Colors.text-muted;
        }
    }

    // embed (kind 22): a link shown as a card, because SPEC §二 and §三十三
    // rule out the WebView that would otherwise be sitting in this box. The
    // address is the block's own text — click the card and that is what you
    // edit — and the two lines are derived from it, so there is no second copy
    // of the link to fall out of step. The one action leaves the app.
    Rectangle {
        x: content-x;
        y: top-margin;
        width: content-width;
        height: root.body-height;
        visible: is-embed;
        border-radius: Theme.radius-md;
        border-width: 1px;
        border-color: ta.has-hover ? Colors.border-strong : Colors.border;
        background: block.bg > 0 ? block-bg-color : Colors.code-background;

        Icon {
            x: Theme.spacing-md;
            y: (parent.height - self.height) / 2;
            name: "link";
            size: 19px;
            stroke-width: 1.6px;
            color: Colors.text-secondary;
        }
        embed-label := Text {
            x: root.embed-inset;
            y: Theme.spacing-md;
            height: PageType.size-body * PageType.line-body;
            width: Math.max(0px, parent.width - self.x - 44px);
            // the card's own words stand aside for the live input, except on an
            // empty one: a caret with nothing beside it reads as a broken box
            visible: is-embed && (!editing || block.text == "");
            text: is-embed ? UIState.embed-label(block.text) : "";
            vertical-alignment: center;
            font-family: PageType.font-family;
            font-size: PageType.size-body;
            font-weight: Typography.weight-semibold;
            color: block-text-color;
            overflow: elide;
        }
        Text {
            x: embed-label.x;
            y: embed-label.y + embed-label.height;
            height: Typography.size-caption * PageType.line-body;
            width: embed-label.width;
            visible: embed-label.visible;
            // the address as the Open button will use it, so what the card
            // shows is what pressing it does — a bare domain reads as https://
            text: is-embed ? (block.text == ""
                ? "还没有地址" : UIState.embed-url(block.text)) : "";
            vertical-alignment: center;
            font-family: Typography.ui-font;
            font-size: Typography.size-caption;
            color: Colors.text-muted;
            overflow: elide;
        }
        // Always drawn, like the file block's two: a card that offers nothing
        // to press reads as a broken embed.
        Rectangle {
            x: parent.width - 34px;
            y: (parent.height - self.height) / 2;
            width: 26px;
            height: 26px;
            border-radius: Theme.radius-xs;
            background: embed-open-ta.has-hover ? Colors.surface-hover : transparent;
            animate background { duration: Theme.duration-instant; }
            Icon {
                x: 4px; y: 4px;
                name: "arrow-right";
                size: 18px;
                stroke-width: 1.7px;
                color: Colors.text-secondary;
            }
            embed-open-ta := TouchArea {
                mouse-cursor: MouseCursor.pointer;
                clicked => {
                    UIState.open-link(UIState.embed-url(block.text));
                }
            }
        }
    }

    Rectangle {
        x: content-x;
        y: top-margin + 10px;
        width: content-width;
        height: 1px;
        visible: block.kind == 9;
        background: Colors.divider;
    }
    // callout (kind 10), the text. Its tinted box and emoji are above the
    // runs, and for a reason worth reading before moving them (ADR-0043).
    callout-text := Text {
        x: runs-x;
        y: runs-y;
        width: runs-width;
        visible: block.kind == 10 && !editing && block.runs.length == 0;
        text: block.text;
        font-family: PageType.font-family;
        font-size: PageType.size-body;
        color: block-text-color;
        line-height-factor: PageType.line-body;
        wrap: word-wrap;
    }

    // page (kind 11) and link-to-page (kind 12) blocks: an icon and the
    // target page's live title. Open-only (never editable); the controller
    // turns activation into a page open. A dangling reference reads muted;
    // a link block's icon is the anchor-style affordance.
    Icon {
        x: content-x;
        y: top-margin + 2px;
        visible: is-page-ish;
        name: is-link ? "link" : "page";
        size: 17px;
        stroke-width: 1.6px;
        color: block.page-ref >= 0 ? Colors.text-secondary : Colors.text-muted;
    }
    // A mirror says which row it is. Two interlocked rings, which is what the
    // row *is*: one sentence, looked at from somewhere else. The glyph sits in
    // the gutter the row reserved above, never in the sentence — those words
    // belong to another block and this is the one thing here that does not.
    if root.is-synced : Icon {
        x: content-x;
        y: top-margin + 2px;
        name: "link";
        size: 15px;
        stroke-width: 1.6px;
        // resolved and unresolved look alike on purpose: whether the sentence
        // arrived is said by the words in the column, not by this getting louder
        color: block.sync-source > 0 ? Colors.text-secondary : Colors.text-muted;
    }

    page-text := Text {
        x: content-x + 26px;
        y: top-margin;
        width: content-width - 26px;
        visible: is-page-ish;
        text: block.text;
        font-family: PageType.font-family;
        font-size: body-font-size;
        color: block.page-ref >= 0 ? block-text-color : Colors.text-muted;
        line-height-factor: body-line-factor;
        wrap: word-wrap;
    }

    // picture (kind 14). The source arrives through `image-for`, so only a
    // realized row ever decodes it; the width is the block's own tier and the
    // height follows the raster's ratio (SPEC §三十七, §二十二).
    Rectangle {
        x: content-x;
        y: top-margin;
        width: root.pic-width;
        height: root.pic-height;
        visible: is-image && pic-aspect > 0;
        clip: true;
        border-radius: Theme.radius-sm;
        Image {
            x: 0; y: 0;
            width: parent.width; height: parent.height;
            // the box is already the raster's own ratio, so this is exact
            image-fit: contain;
            source: UIState.image-for(block.attachment);
        }
    }
    missing-text := Text {
        x: content-x;
        y: top-margin;
        width: content-width;
        visible: is-image && pic-aspect <= 0;
        text: block.text + " · 无图片";
        font-family: PageType.font-family;
        font-size: PageType.size-body;
        color: Colors.text-muted;
        line-height-factor: PageType.line-body;
        wrap: word-wrap;
    }

    // file (kind 15): a name, a size, and the two things a system can do with
    // stored bytes. Painting this row reads nothing but the attachments row —
    // the label is the block's own text — so a 2 GB attachment costs the same
    // as a 2 KB one until the user asks for it (SPEC §三十七 批次 A, §二十二).
    Rectangle {
        x: content-x;
        y: top-margin;
        width: content-width;
        height: root.file-height;
        visible: is-file;
        border-radius: Theme.radius-md;
        border-width: 1px;
        border-color: ta.has-hover ? Colors.border-strong : Colors.border;
        background: block.bg > 0 ? block-bg-color : Colors.code-background;

        Icon {
            x: Theme.spacing-md;
            y: (parent.height - self.height) / 2;
            name: "page";
            size: 19px;
            stroke-width: 1.6px;
            color: Colors.text-secondary;
        }
        file-text := Text {
            x: Theme.spacing-md + 19px + Theme.spacing-sm;
            y: 0;
            height: parent.height;
            width: Math.max(0px, parent.width - self.x - 140px);
            vertical-alignment: center;
            text: block.text;
            font-family: PageType.font-family;
            font-size: PageType.size-body;
            color: block-text-color;
            overflow: elide;
        }
        Text {
            x: parent.width - 132px;
            y: 0;
            width: 60px;
            height: parent.height;
            vertical-alignment: center;
            horizontal-alignment: right;
            text: root.file-size;
            font-family: Typography.ui-font;
            font-size: Typography.size-caption;
            color: Colors.text-muted;
        }
        // Always drawn rather than hover-revealed: a row that offers nothing
        // to press reads as a broken attachment, which is the one thing a
        // file block must never look like.
        Rectangle {
            x: parent.width - 64px;
            y: (parent.height - self.height) / 2;
            width: 26px;
            height: 26px;
            border-radius: Theme.radius-xs;
            background: open-ta.has-hover ? Colors.surface-hover : transparent;
            animate background { duration: Theme.duration-instant; }
            Icon {
                x: 4px; y: 4px;
                name: "arrow-right";
                size: 18px;
                stroke-width: 1.7px;
                color: Colors.text-secondary;
            }
            open-ta := TouchArea {
                mouse-cursor: MouseCursor.pointer;
                clicked => {
                    UIState.attachment-opened(block.attachment);
                }
            }
        }
        Rectangle {
            x: parent.width - 34px;
            y: (parent.height - self.height) / 2;
            width: 26px;
            height: 26px;
            border-radius: Theme.radius-xs;
            background: save-ta.has-hover ? Colors.surface-hover : transparent;
            animate background { duration: Theme.duration-instant; }
            Icon {
                x: 4px; y: 4px;
                name: "export";
                size: 18px;
                stroke-width: 1.7px;
                color: Colors.text-secondary;
            }
            save-ta := TouchArea {
                mouse-cursor: MouseCursor.pointer;
                clicked => {
                    UIState.attachment-saved(block.attachment);
                }
            }
        }
    }

    // table (kind 16): the whole grid is this one row. Its cells are child
    // blocks the projection hides, so they reach the grid inside the row's
    // own data (SPEC §三十七 批次 B).
    tbl := TableBlock {
        x: content-x;
        y: top-margin;
        width: content-width;
        visible: is-table;
        block: block;
        grid-width: content-width;
        // the cells raise the "@" picker under their own row (SPEC §四十)
        anchor-y: row-y + top-margin;
        anchor-x: content-x;
        hovered: ta.has-hover || handle.hovered || tbl.inner-hover;
    }

    // columns (kind 18): the whole layout is this one row, and its boxes'
    // blocks ride in on the row's data for the same reason a grid's do
    clm := ColumnsBlock {
        x: content-x;
        y: top-margin;
        width: content-width;
        visible: is-columns;
        block: block;
        layout-width: content-width;
        line-y: row-y;
        line-x: content-x;
        hovered: ta.has-hover || handle.hovered || clm.inner-hover;
    }

    // database (kind 23): the whole view is this one row. Its rows are records,
    // not child blocks, so nothing is hidden from the projection — the row
    // carries the realized window plus the view's own shape (SPEC §三十九).
    // Declared after `ta` like the grid and the layout: the cells are the
    // things you aim at, so they win the click. `row-y` is the block body's
    // top in list coords, which is the anchor the component's scroll
    // arithmetic reports back to Rust (`db-viewport`).
    dbv := DatabaseView {
        x: content-x;
        y: top-margin;
        width: content-width;
        visible: is-database;
        block: block;
        content-width: content-width;
        row-y: root.row-y + top-margin;
    }

    // drag-reorder drop indicator: accent line where the block would land.
    // "Below the last block" paints on the tail row's bottom edge instead.
    Rectangle {
        x: root.content-x - 8px;
        width: root.content-width + 16px;
        y: -1px;
        height: 2px;
        background: Colors.accent;
        visible: UIState.drop-line-row == root.index;
    }
    Rectangle {
        x: root.content-x - 8px;
        width: root.content-width + 16px;
        y: root.height - 1px;
        height: 2px;
        background: Colors.accent;
        visible: block.tail && UIState.drop-line-row == UIState.blocks.length;
    }
}
