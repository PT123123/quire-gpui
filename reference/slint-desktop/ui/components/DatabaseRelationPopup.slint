// The relation editor (D10, SPEC §三十九 「属性」, ADR-0088): the popup a
// relation cell's click opens, and the only door this build has to the two
// things a relation needs before it can hold anything — which database it
// points at, and whether the pointing is two-way.
//
// One popup with three states, because "link these two databases" and "which
// rows?" are one feature asked in the other's order:
//
//   * **0, the picker** — a needle box over the target database's rows, each
//     ticked when this cell already holds it. Ticking is a write: the cell's
//     whole list and every back-pointer that change implies land as *one*
//     command, so a pick is one Ctrl+Z (ADR-0088).
//   * **1, the target** — every database in the file, this one's included: a
//     self-relation ("this blocks that") is legal, and the row says so.
//   * **2, the back-pointer** — the target's relation columns, with "no
//     back-pointer" first. A column `check_pair` refuses is drawn greyed with
//     the refusal as its caption, because "that column already points back at
//     another column" is a fact about a database the user is looking at.
//
// Which state it opens in is Rust's: an unconfigured column starts at 1 (a
// picker with nothing to list would be an empty box), a configured one at 0.
// Picking a target *is* the declaration (one write), which is what lets state 2
// offer the target's columns at all; picking a mirror declares the pair.
//
// The list is **capped** (Rust pushes at most `DB_RELATION_PICK_LIMIT` rows)
// and the needle is the way past the cap: a picker that listed a 10 000-row
// database would be the windowed read's red line through the back door.

import { Theme } from "../Theme.slint";
import { Colors } from "../Colors.slint";
import { Typography } from "../Typography.slint";
import { UIState } from "../Types.slint";
import { DatabasePickList } from "./DatabasePickList.slint";

export component DatabaseRelationPopup inherits PopupWindow {
    width: 360px;
    // Header (34) + the needle's box (28) + a gap, then the list, then the
    // footer's row (26) — and the same reserve is what keeps the empty-list
    // note from landing on the footer when there is no list.
    height: UIState.db-relation-panel == 0
        ? UIState.db-relation-rows.length * 28px + 118px
        : UIState.db-relation-rows.length * 32px + 60px;
    // outside click / Escape dismiss; UIState syncs via the is-open mirror
    close-policy: PopupClosePolicy.close-on-click-outside;

    Rectangle {
        x: 2px; y: 3px;
        width: parent.width - 4px;
        height: parent.height - 5px;
        border-radius: Theme.radius-md + 2px;
        background: Colors.shadow;
    }
    Rectangle {
        width: parent.width;
        height: parent.height;
        border-radius: Theme.radius-md;
        background: Colors.surface-overlay;
        border-width: 1px;
        border-color: Colors.border;
        clip: true;

        // ── the header: which column this is, and what kind of thing it is ──
        Text {
            x: 12px;
            y: 10px;
            width: parent.width - 24px;
            height: 20px;
            vertical-alignment: center;
            overflow: elide;
            text: UIState.db-relation-name;
            font-family: Typography.ui-font;
            font-size: Typography.size-ui;
            font-weight: Typography.weight-semibold;
            color: Colors.text-primary;
        }
        Text {
            x: 12px;
            y: 10px;
            width: parent.width - 24px;
            height: 20px;
            vertical-alignment: center;
            horizontal-alignment: right;
            text: "关系";
            font-family: Typography.ui-font;
            font-size: Typography.size-caption;
            color: Colors.text-muted;
        }

        // ── state 0: the picker ────────────────────────────────────────────
        if UIState.db-relation-panel == 0 : Rectangle {
            width: parent.width;
            height: parent.height;
            background: transparent;

            Rectangle {
                x: 12px;
                y: 34px;
                width: parent.width - 24px;
                height: 28px;
                border-radius: Theme.radius-sm;
                background: Colors.surface;
                border-width: 1px;
                border-color: rel-needle.has-focus ? Colors.accent : Colors.border;

                rel-needle := TextInput {
                    x: 8px;
                    y: 0px;
                    width: parent.width - 16px;
                    height: parent.height;
                    vertical-alignment: center;
                    single-line: true;
                    text <=> UIState.db-relation-text;
                    font-family: Typography.ui-font;
                    font-size: Typography.size-ui;
                    color: Colors.text-primary;
                    selection-foreground-color: Colors.text-primary;
                    selection-background-color: Colors.selection;

                    edited => {
                        UIState.db-relation-text-set(self.text);
                    }
                    accepted => {
                        // Enter on a needle means "stop looking": the popup
                        // closes and the cell shows what it holds. The picks
                        // themselves are the list's, not the keyboard's.
                        UIState.db-relation-closed();
                    }
                    key-pressed(event) => {
                        if (event.text == Key.Escape) {
                            UIState.db-relation-closed();
                            accept
                        } else {
                            reject
                        }
                    }
                    init => {
                        // created with the focus, like every other input that
                        // arrives with its popup
                        rel-needle.focus();
                    }
                }

                // placeholder (TextInput has none built in) — the same shape
                // CommandPalette's uses, so the popup says which database the
                // search runs over before the user types one character
                Text {
                    x: 8px;
                    width: parent.width - 16px;
                    height: parent.height;
                    visible: UIState.db-relation-text == "";
                    vertical-alignment: center;
                    overflow: elide;
                    font-family: Typography.ui-font;
                    font-size: Typography.size-ui;
                    color: Colors.text-muted;
                    text: UIState.db-relation-target == ""
                        ? "输入以查找行"
                        : "在其中查找行：" + UIState.db-relation-target;
                }
            }

            DatabasePickList {
                x: 12px;
                y: 66px;
                width: parent.width - 24px;
                row-height: 28px;
                rows: UIState.db-relation-rows;
                picked(id) => {
                    UIState.db-relation-toggled(id);
                }
            }

            // An empty target database is not an error — the rows may simply
            // not exist yet — so it says what it is instead of drawing a box.
            if UIState.db-relation-rows.length == 0 : Text {
                x: 12px;
                y: 66px;
                width: parent.width - 24px;
                height: 20px;
                vertical-alignment: center;
                text: UIState.db-relation-text == ""
                    ? "还没有可链接的行。"
                    : "没有匹配项。";
                font-family: Typography.ui-font;
                font-size: Typography.size-caption;
                color: Colors.text-muted;
            }

            // The other half of the feature is one click away for a column
            // that is already configured: what it links *to*.
            Rectangle {
                x: 8px;
                y: parent.height - 26px;
                width: parent.width - 16px;
                height: 20px;
                border-radius: Theme.radius-sm;
                background: retarget-ta.has-hover ? Colors.surface-hover : transparent;

                Text {
                    x: 8px;
                    width: parent.width - 16px;
                    height: parent.height;
                    vertical-alignment: center;
                    text: "‹ 更改链接目标";
                    font-family: Typography.ui-font;
                    font-size: Typography.size-caption;
                    color: Colors.text-muted;
                }
                retarget-ta := TouchArea {
                    width: parent.width;
                    height: parent.height;
                    mouse-cursor: MouseCursor.pointer;
                    clicked => {
                        UIState.db-relation-panel-set(1);
                    }
                }
            }
        }

        // ── states 1–2: the two declarations ───────────────────────────────
        if UIState.db-relation-panel != 0 : Rectangle {
            width: parent.width;
            height: parent.height;
            background: transparent;

            // The question the list answers. In state 2 it doubles as the way
            // home — the "‹" is the same affordance the filter panel's choosers
            // use, so one line is both the question and the back row, and
            // state 1's identical line without the mark is inert (it *is* the
            // way home).
            Text {
                x: 12px;
                y: 32px;
                width: parent.width - 24px;
                height: 18px;
                vertical-alignment: center;
                text: UIState.db-relation-panel == 1
                    ? "链接到哪个数据库？"
                    : "‹ 在哪个列中反向显示？";
                font-family: Typography.ui-font;
                font-size: Typography.size-caption;
                color: UIState.db-relation-panel == 1 ? Colors.text-muted
                    : (back-ta.has-hover ? Colors.text-primary : Colors.text-muted);
            }
            back-ta := TouchArea {
                x: 12px;
                y: 30px;
                width: parent.width - 24px;
                height: 22px;
                enabled: UIState.db-relation-panel == 2;
                mouse-cursor: MouseCursor.pointer;
                clicked => {
                    UIState.db-relation-panel-set(1);
                }
            }

            DatabasePickList {
                x: 8px;
                y: 54px;
                width: parent.width - 16px;
                row-height: 32px;
                rows: UIState.db-relation-rows;
                picked(id) => {
                    if (UIState.db-relation-panel == 1) {
                        UIState.db-relation-database-picked(id);
                    } else {
                        UIState.db-relation-mirror-picked(id);
                    }
                }
            }
        }
    }
}
