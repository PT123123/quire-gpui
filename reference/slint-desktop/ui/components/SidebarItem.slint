// One row of the sidebar. `node.kind` decides whether it renders as a
// section header, a nav entry, a page-tree node, or the "New page" action.

import { Theme } from "../Theme.slint";
import { Colors } from "../Colors.slint";
import { Typography } from "../Typography.slint";
import { Icon } from "../Icons.slint";
import { UIState, SidebarNode } from "../Types.slint";

export component SidebarItem inherits Rectangle {
    in property <SidebarNode> node;
    in property <int> index; // model row: the page-drag callbacks address rows by it

    property <bool> is-header: node.kind == "header";
    property <bool> is-page: node.kind == "page";
    // Every row that *is* a page answers a right-click with the page's menu — the
    // tree's own rows and the replicas the 收藏 / 最近 sections re-list, which had
    // no handler at all and read as rows that do nothing. Renaming, dragging and
    // dropping stay on the tree's row: a replica is a way to get somewhere, not a
    // second place a page is edited from.
    property <bool> is-page-row: is-page || node.kind == "favorite" || node.kind == "recent";
    // The Workspace header is the tree's own door (with the header at the top of
    // the rail): it carries the workspace's menu, not a page's.
    property <bool> is-workspace: is-header && node.id == -100;
    // The 收藏 / 最近 section headers (ids -15 / -16 in Rust) are the two that
    // fold: clicking one toggles its section, which is why they carry an id at
    // all — the workspace header carries one for the drop target, these for the
    // toggle.
    property <bool> is-section: is-header && (node.id == -15 || node.id == -16);
    property <bool> is-new-page: node.kind == "new-page";
    property <bool> renaming: is-page && UIState.renaming-id == node.id;
    // a page row or the Workspace header shows the "landing here" tint
    property <bool> drop-target: UIState.page-drop-target-id == node.id
        && (is-page || (is-header && node.id == -100));
    // The lit row is only ever *this* area's. `node.selected` is Rust's
    // projection of `open_page`, and the organizer never opens one — so while
    // it is showing, the page the tree still names is covered, and a second
    // lit row beside the pinned 笔记/任务 row would say the window is in two
    // places at once.
    property <bool> lit: node.selected
        && UIState.active-area != "organizer";
    // The two sections re-list pages as smaller rows — a replica is a shortcut,
    // not a second place the page lives, so it reads one step quieter than the
    // tree's own rows (the same 24 px / caption step the section labels use).
    property <bool> is-replica: node.kind == "favorite" || node.kind == "recent";

    height: is-header ? 26px : is-replica ? 24px : 28px;
    border-radius: Theme.radius-sm;
    background: drop-target ? Colors.accent-soft
        : lit
        ? Colors.surface-selected
        : (ta.has-hover && !renaming ? Colors.hover-fill : transparent);
    animate background { duration: Theme.duration-instant; }

    HorizontalLayout {
        spacing: Theme.spacing-sm;
        padding-left: Theme.spacing-xs + node.depth * 14px;
        padding-right: Theme.spacing-sm;
        cross-axis-alignment: center;

        // The two foldable section headers carry a chevron in the icon slot:
        // the affordance that says the row folds, in the same language the
        // page tree's own expanders use.
        if is-section : Rectangle {
            width: 16px;
            height: 16px;
            Icon {
                width: 12px;
                height: 12px;
                size: 12px;
                name: node.expanded ? "chevron-down" : "chevron-right";
                color: ta.has-hover ? Colors.text-secondary : Colors.text-muted;
            }
        }
        if !is-header : Rectangle {
            width: 16px;
            height: 16px;
            // chevron area doubles as the expand/collapse click target;
            // leaves and the action row show their plain icon.
            if is-page && node.has-children : Rectangle {
                width: 16px;
                height: 16px;
                // A parent shows its own emoji here and gives the slot to the
                // expander while the pointer is on it. The second option -- a
                // slot for each -- pushed every parent's label one indent past
                // its children, which is how the tree lost its shape.
                if node.icon != "" : Text {
                    visible: !chev-ta.has-hover;
                    width: parent.width;
                    height: parent.height;
                    text: node.icon;
                    font-family: Typography.emoji-font;
                    font-size: Typography.size-icon-sidebar;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                Icon {
                    visible: chev-ta.has-hover || node.icon == "";
                    width: 14px;
                    height: 14px;
                    size: 14px;
                    name: node.expanded ? "chevron-down" : "chevron-right";
                    color: chev-ta.has-hover ? Colors.text-primary : Colors.text-muted;
                }
                chev-ta := TouchArea {
                    mouse-cursor: MouseCursor.pointer;
                    clicked => {
                        UIState.node-expand-toggled(node.id);
                    }
                }
            }
            if !(is-page && node.has-children) : Rectangle {
                width: 16px;
                height: 16px;
                if node.icon != "" : Text {
                    width: parent.width;
                    height: parent.height;
                    text: node.icon;
                    font-family: Typography.emoji-font;
                    // a replica's emoji reads one step smaller, like its label
                    font-size: is-replica ? Typography.size-caption : Typography.size-icon-sidebar;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                if node.icon == "" : Icon {
                    width: 15px;
                    height: 15px;
                    size: 15px;
                    name: is-new-page ? "plus"
                        : node.kind == "favorite" ? "star"
                        : node.kind == "recent" ? "clock"
                        : "page";
                    color: is-new-page ? Colors.text-muted
                        : lit ? Colors.accent-text
                        : (ta.has-hover ? Colors.text-secondary : Colors.text-muted);
                }
            }
        }

        // label or inline rename input
        if renaming : Rectangle {
            height: 22px;
            border-radius: Theme.radius-xs;
            background: Colors.background;
            border-width: 1px;
            border-color: Colors.accent;
            rename-input := TextInput {
                x: 4px;
                width: parent.width - 8px;
                height: parent.height;
                vertical-alignment: center;
                font-family: Typography.ui-font;
                font-size: Typography.size-ui;
                color: Colors.text-primary;
                selection-foreground-color: Colors.text-primary;
                selection-background-color: Colors.selection;
                single-line: true;
                text: node.label;
                accepted => {
                    UIState.rename-committed(node.id, self.text);
                }
                key-pressed(event) => {
                    if (event.text == Key.Escape) {
                        UIState.rename-cancelled();
                        accept
                    } else {
                        reject
                    }
                }
                init => {
                    rename-input.focus();
                    rename-input.select-all();
                }
            }
        }
        if !renaming : Text {
            text: node.label;
            font-family: Typography.ui-font;
            font-size: is-header ? Typography.size-caption
                : is-replica ? Typography.size-caption
                : Typography.size-ui;
            font-weight: is-header ? Typography.weight-semibold : Typography.weight-regular;
            color: is-header ? (is-section && ta.has-hover ? Colors.text-secondary : Colors.text-muted)
                : is-new-page ? Colors.text-muted
                : lit ? Colors.text-primary
                : Colors.text-secondary;
            overflow: elide;
            vertical-alignment: center;
        }
    }

    // drag source for page rows: a press that moves past the threshold
    // starts the move-drag, a plain click still reaches the TouchArea below
    // (the block handle's pattern). Right-click passes through untouched.
    drag := DragArea {
        enabled: is-page && !renaming;
        allow-move: true;
        data: UIState.page-drag-payload(node.id);
        drag-finished => {
            UIState.page-drop-target-id = -1;
        }
    }

    ta := TouchArea {
        enabled: !renaming;
        mouse-cursor: MouseCursor.pointer;
        clicked => {
            // a foldable section header folds its section and stops there: it
            // is not a place, so it never lands in sidebar-selected-id
            if (is-section) {
                UIState.sidebar-section-toggled(node.id);
            } else {
                UIState.sidebar-selected-id = node.id;
                UIState.node-clicked(node.id);
            }
        }
        pointer-event(event) => {
            if (event.kind == PointerEventKind.up
                && event.button == PointerEventButton.right
                && (is-page-row || is-workspace)) {
                // the row reports its own y: a 收藏 / 最近 replica and the tree's
                // row of the same page are two rows, and `sidebar_row_y` would
                // anchor the popup on whichever of them comes first.
                UIState.node-context(node.id, root.absolute-position.y);
            }
        }
    }

    // drop target: pages accept drops INTO them (the page becomes a child),
    // the Workspace header accepts a drop at the top level
    DropArea {
        can-drop(event) => {
            if (UIState.page-drag-hover(event.data, root.index)) {
                UIState.page-drop-target-id = node.id;
                DragAction.move
            } else {
                UIState.page-drop-target-id = -1;
                DragAction.none
            }
        }
        dropped(event) => {
            UIState.page-dropped(event.data, root.index);
            UIState.page-drop-target-id = -1;
            DragAction.move
        }
    }
}
