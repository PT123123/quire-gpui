// Right-click / ⋯ context menu. One instance lives at window level; the
// controller positions it (UIState.menu-x/y) and fills the rows. Closing is
// driven by UIState.menu-open; outside clicks / Escape dismiss via the
// close-on-click-outside policy, and AppWindow mirrors the popup's
// `is-open` back into UIState (a popup must not read its own `is-open` —
// slint 1.18 const-prop crash).

import { Theme } from "../Theme.slint";
import { Colors } from "../Colors.slint";
import { Typography } from "../Typography.slint";
import { Icon } from "../Icons.slint";
import { ListView } from "std-widgets.slint";
import { UIState } from "../Types.slint";

export component ContextMenu inherits PopupWindow {
    width: 184px;
    // natural height, clamped to the window space below the anchor so a
    // tall Move-to list scrolls inside the popup instead of running off
    // the window bottom (A4 sweep D3)
    height: min(
        UIState.menu-rows.length * 30px + 8px,
        max(UIState.window-h - UIState.menu-y - 20px, 120px),
    );
    close-policy: PopupClosePolicy.close-on-click-outside;

    Rectangle {
        width: parent.width;
        height: parent.height;

        Rectangle {
            x: 2px; y: 3px;
            width: parent.width - 4px;
            height: parent.height - 5px;
            border-radius: Theme.radius-md + 2px;
            background: Colors.shadow;
        }
        Rectangle {
            width: parent.width;
            height: parent.height;
            border-radius: Theme.radius-md;
            background: Colors.surface-overlay;
            border-width: 1px;
            border-color: Colors.border;
        }

        ListView {
            x: 4px; y: 4px;
            width: parent.width - 8px;
            height: parent.height - 8px;
            content-width: self.width;

            for item in UIState.menu-rows : Rectangle {
                width: parent.content-width;
                height: 30px;
                border-radius: Theme.radius-sm;
                background: row-ta.has-hover ? Colors.surface-hover : transparent;
                animate background { duration: Theme.duration-instant; }

                HorizontalLayout {
                    spacing: Theme.spacing-sm;
                    padding-left: Theme.spacing-sm;
                    padding-right: Theme.spacing-sm;
                    // A color row carries a swatch instead of an icon — the same
                    // `MenuRow` the block menu draws, rendered the same way, so the
                    // organizer's list colours look like every other palette here.
                    if item.swatch >= 0 : Rectangle {
                        vertical-stretch: 0;
                        cross-axis-self-alignment: center;
                        width: 14px;
                        height: 14px;
                        border-radius: 7px;
                        background: item.swatch-bg ? Colors.block-bg(item.swatch)
                            : Colors.block-text(item.swatch);
                        // every background swatch carries a border: the light
                        // pastels are invisible on the popup (A4 sweep)
                        border-width: item.swatch-bg ? 1px : 0px;
                        border-color: Colors.border-strong;
                    }
                    if item.swatch < 0 : Icon {
                        vertical-stretch: 0;
                        cross-axis-self-alignment: center;
                        width: 14px;
                        height: 14px;
                        size: 14px;
                        name: item.icon;
                        color: item.danger ? Colors.danger
                            : (row-ta.has-hover ? Colors.text-primary : Colors.text-secondary);
                    }
                    Text {
                        text: item.label;
                        // The label takes the leftover width so the current-pick check
                        // sits at the row's right edge; a bare Text would size to its
                        // content and push the check off the popup.
                        horizontal-stretch: 1;
                        font-family: Typography.ui-font;
                        font-size: Typography.size-ui;
                        color: item.danger ? Colors.danger
                            : (row-ta.has-hover ? Colors.text-primary : Colors.text-secondary);
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    // The "current pick" check: the organizer's list-colour submenu
                    // and the page's Style rows both mark one row with it.
                    if item.check : Icon {
                        vertical-stretch: 0;
                        cross-axis-self-alignment: center;
                        width: 13px;
                        height: 13px;
                        size: 13px;
                        name: "todo-check";
                        stroke-width: 2.6px;
                        color: Colors.accent;
                    }
                }

                row-ta := TouchArea {
                    mouse-cursor: MouseCursor.pointer;
                    clicked => {
                        UIState.menu-open = false;
                        UIState.menu-action(item.id);
                    }
                }
            }
        }
    }
}
