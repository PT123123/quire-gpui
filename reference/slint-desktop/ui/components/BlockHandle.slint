// Block hover affordances (Notion-style "+  ⋮⋮"), shown left of the focused
// or hovered block.

import { Theme } from "../Theme.slint";
import { Colors } from "../Colors.slint";
import { Icon } from "../Icons.slint";
import { UIState } from "../Types.slint";

export component BlockHandle inherits Rectangle {
    in property <bool> visible-flag: false;
    in property <int> block-id: -1;
    callback plus-clicked();
    callback grip-clicked();
    // the handle's own TouchAreas sit above the row's and take the hover —
    // the row must keep the handle visible while the cursor is on them
    out property <bool> hovered: ta1.has-hover || ta2.has-hover;
    width: 44px;
    height: 26px;
    opacity: visible-flag ? 1 : 0;
    animate opacity { duration: Theme.duration-fast; }

    HorizontalLayout {
        spacing: 0px;
        Rectangle {
            width: 22px;
            height: 26px;
            border-radius: Theme.radius-xs;
            background: ta1.has-hover ? Colors.hover-fill : transparent;
            Icon {
                x: 3px; y: 5px;
                name: "plus";
                size: 15px;
                color: Colors.text-muted;
            }
            ta1 := TouchArea {
                mouse-cursor: MouseCursor.pointer;
                clicked => {
                    root.plus-clicked();
                }
            }
        }
        Rectangle {
            width: 22px;
            height: 26px;
            border-radius: Theme.radius-xs;
            background: ta2.has-hover ? Colors.hover-fill : transparent;
            Icon {
                x: 3px; y: 5px;
                name: "grip";
                size: 15px;
                color: Colors.text-muted;
            }
            // drag past the threshold starts a move-drag; a plain click
            // never starts one, so the menu TouchArea below stays clickable
            DragArea {
                allow-move: true;
                data: UIState.block-drag-payload(root.block-id);
                drag-finished => {
                    UIState.drop-line-row = -1;
                }
                ta2 := TouchArea {
                    mouse-cursor: MouseCursor.pointer;
                    clicked => {
                        root.grip-clicked();
                    }
                }
            }
        }
    }
}
