// Type scale. Windows-first font stack; mono for code blocks.

import { Theme } from "Theme.slint";
import { UIState } from "Types.slint";

export global Typography {
    out property <string> ui-font: "Segoe UI";
    out property <string> display-font: "Segoe UI Semibold";
    out property <string> serif-font: "Georgia";
    out property <string> mono-font: "Consolas";
    // Color emoji on Windows resolve against this face. It is asked for by
    // name because a `Text` here would otherwise fall back to Segoe UI, which
    // carries monochrome glyphs for the same code points. The page's icon is
    // the character itself (SPEC §三十八), so this is the one place naming the
    // face that draws it.
    out property <string> emoji-font: "Segoe UI Emoji";

    // page chrome
    out property <length> size-caption: 11px;   // section labels, hints
    out property <length> size-ui: 13px;        // sidebar rows, menus, buttons
    out property <length> size-ui-lg: 14px;     // palette items
    out property <length> size-icon-sidebar: 13px; // a page's emoji, in its row
    out property <length> size-icon-picker: 19px;  // one cell of the emoji grid
    // A page's cover band (SPEC §三十八, ADR-0047). Deliberately not on
    // `PageType`: small text shrinks a page's type, and a picture has no
    // typeface. `size-cover-overlap` is the part of the band the hero title is
    // drawn inside -- the requirement is that the title sits *on* the cover, so
    // the band is not merely a strip above it.
    out property <length> size-cover-height: 168px;
    out property <length> size-cover-overlap: 68px;

    // document
    out property <length> size-body: 15.5px;
    out property <float> line-body: 1.55;  // factor of natural line height
    out property <length> size-h3: 18px;
    out property <float> line-h3: 1.5;
    out property <length> size-h2: 22px;
    out property <float> line-h2: 1.36;
    out property <length> size-h1: 28px;
    out property <float> line-h1: 1.36;
    out property <length> size-page-title: 38px;
    out property <length> size-code: 13.5px;
    out property <float> line-code: 1.48;

    out property <int> weight-regular: 400;
    out property <int> weight-medium: 500;
    out property <int> weight-semibold: 600;
    out property <int> weight-bold: 700;
}

// One page's own document tier (SPEC §三十八). The three switches live on the
// page, so the scale below is derived and never stored: a block keeps its
// characters and no block ever carries a font-size of its own. That is why
// this is a second global beside `Typography` rather than a rewrite of it —
// the chrome (sidebar, menus, palette, settings) reads `Typography` and must
// not change when one page goes serif or small.
//
// Weights are deliberately not here: 400/500/600/700 ask the family for a
// face it may not ship, and both serif and mono do have them on Windows.
export global PageType {
    // Small text scales the whole document tier, headings included, by one
    // factor — 13.5/15.5, which is the ratio Notion's own two tiers use.
    property <float> scale: UIState.page-small-text ? 0.87 : 1;

    out property <bool> full-width: UIState.page-full-width;
    out property <string> font-family: UIState.page-font == 1
        ? Typography.serif-font
        : UIState.page-font == 2
            ? Typography.mono-font
            : Typography.ui-font;

    // The same choice in its italic face. The marked runs name the family
    // rather than setting `font-italic`, so a serif page would otherwise
    // italicise its emphasis in Segoe while every other word is Georgia.
    out property <string> italic-font-family: UIState.page-font == 1
        ? "Georgia Italic"
        : UIState.page-font == 2
            ? "Consolas Italic"
            : "Segoe UI Italic";

    out property <length> size-body: Typography.size-body * scale;
    out property <length> size-h3: Typography.size-h3 * scale;
    out property <length> size-h2: Typography.size-h2 * scale;
    out property <length> size-h1: Typography.size-h1 * scale;
    out property <length> size-page-title: Typography.size-page-title * scale;
    out property <length> size-code: Typography.size-code * scale;
    // The page's own emoji, above its title (SPEC §三十八). Document tier, so
    // small text shrinks it along with everything else on the page.
    out property <length> size-page-icon: 46px * scale;

    // Line heights are factors of the natural line box, so a smaller face
    // gets a proportionally smaller box without touching these.
    out property <float> line-body: Typography.line-body;
    out property <float> line-h3: Typography.line-h3;
    out property <float> line-h2: Typography.line-h2;
    out property <float> line-h1: Typography.line-h1;
    out property <float> line-code: Typography.line-code;
}
